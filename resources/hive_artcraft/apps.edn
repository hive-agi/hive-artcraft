;; The Crafting App registry: ONE data list of app modules (hive-artcraft.schema/AppModule).
;; Add an app by appending one module map (plus, for a :native app, one catalog resource
;; under hive_artcraft/catalogs/<id>.edn). Shared code never changes. Every classpath copy of
;; hive_artcraft/apps.edn is concatenated, so another jar can contribute apps too.
;; Default control ports: decision memory 20261018171653-7ef42121 (no collisions).
[
 {:app/id "photocraft"
  :app/label "PhotoCraft"
  :app/summary "Image editing, layers, PSD. Mounted from io.github.hive-agi/hive-photocraft."
  :app/kind :mount
  :app/transport :port
  :app/default-port 7878
  :app/port-env "PHOTOCRAFT_CONTROL_PORT"
  ;; PhotoCraft's control channel authenticates: a live port also needs :token-ref
  ;; ({:scheme :file :path ...} or {:scheme :env :name "PHOTOCRAFT_CONTROL_TOKEN"}).
  :app/mount {:ctor hive-photocraft.addon/addon-ctor
              :addon-id "hive.photocraft"
              :port-requires [:token-ref]}
  :app/upstream "https://github.com/storytold/photocraft"}

 {:app/id "vectorcraft"
  :app/label "VectorCraft"
  :app/summary "Vector illustration. Mounted from io.github.hive-agi/hive-vectorcraft."
  :app/kind :mount
  :app/transport :port
  :app/default-port 7979
  :app/port-env "VECTORCRAFT_CONTROL_PORT"
  :app/mount {:ctor hive-vectorcraft.addon/addon-ctor
              :addon-id "hive.vectorcraft"}
  :app/upstream "https://github.com/vectorcraft/vectorcraft"}

 {:app/id "lightcraft"
  :app/label "LightCraft"
  :app/summary "Non-destructive photo library and raw developer (Lightroom-style). Native: `lightcraft --control PORT`."
  :app/kind :native
  :app/transport :port
  :app/default-port 7980
  :app/port-env "LIGHTCRAFT_CONTROL_PORT"
  ;; Derived by dev/extract_lightcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/lightcraft.edn"
  :app/upstream "https://github.com/storytold/lightcraft"}

 {:app/id "designcraft"
  :app/label "DesignCraft"
  :app/summary "Page layout (InDesign-style). Native: `designcraft --control PORT`; upstream docs use 7979, which collides with VectorCraft."
  :app/kind :native
  :app/transport :port
  :app/default-port 7981
  :app/port-env "DESIGNCRAFT_CONTROL_PORT"
  ;; Derived by dev/extract_designcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/designcraft.edn"
  :app/upstream "https://github.com/storytold/designcraft"}

 {:app/id "pdfcraft"
  :app/label "PdfCraft"
  :app/summary "Acrobat-style PDF reader/editor. Native: `pdfcraft --control <FILE>` (random port + token, ui.* methods); call runs ui.command {id}."
  :app/kind :native
  :app/transport :control-file
  ;; Live once configured: :apps {"pdfcraft" {:control-file "~/.pdfcraft-control.json"}}. The token is
  ;; read from that file per request and never logged or returned.
  ;; Derived by dev/extract_pdfcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/pdfcraft.edn"
  :app/upstream "https://github.com/storytold/pdfcraft"}

 {:app/id "studio"
  :app/label "ArtCraft Studio"
  :app/summary "AI image/video/3D studio (Tauri). Catalog-only: its #[tauri::command] fns are in-process webview IPC, with no external control surface."
  :app/kind :native
  :app/transport :none
  ;; Derived by dev/extract_studio.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/studio.edn"
  :app/upstream "https://github.com/storytold/artcraft"}
]
