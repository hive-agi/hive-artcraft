;; The Crafting App registry: ONE data list of app modules (hive-artcraft.schema/AppModule).
;; Add an app by appending one module map (plus, for a :native app, one catalog resource
;; under hive_artcraft/catalogs/<id>.edn). Shared code never changes. Every classpath copy of
;; hive_artcraft/apps.edn is concatenated, so another jar can contribute apps too.
;; Default control ports: decision memory 20261018171653-7ef42121 (no collisions).
[
 {:app/id "photocraft"
  :app/label "PhotoCraft"
  :app/summary "Image editing, layers, PSD. Mounted from io.github.hive-agi/hive-photocraft."
  :app/kind :mount
  :app/transport :port
  :app/default-port 7878
  :app/port-env "PHOTOCRAFT_CONTROL_PORT"
  ;; PhotoCraft's control channel authenticates: a live port also needs :token-ref
  ;; ({:scheme :file :path ...} or {:scheme :env :name "PHOTOCRAFT_CONTROL_TOKEN"}).
  :app/mount {:ctor hive-photocraft.addon/addon-ctor
              :addon-id "hive.photocraft"
              :port-requires [:token-ref]}
  :app/upstream "https://github.com/storytold/photocraft"}

 {:app/id "vectorcraft"
  :app/label "VectorCraft"
  :app/summary "Vector illustration. Mounted from io.github.hive-agi/hive-vectorcraft."
  :app/kind :mount
  :app/transport :port
  :app/default-port 7979
  :app/port-env "VECTORCRAFT_CONTROL_PORT"
  :app/mount {:ctor hive-vectorcraft.addon/addon-ctor
              :addon-id "hive.vectorcraft"}
  :app/upstream "https://github.com/vectorcraft/vectorcraft"}

 {:app/id "lightcraft"
  :app/label "LightCraft"
  :app/summary "Non-destructive photo library and raw developer (Lightroom-style). Native: `lightcraft --control PORT`."
  :app/kind :native
  :app/transport :port
  :app/default-port 7980
  :app/port-env "LIGHTCRAFT_CONTROL_PORT"
  ;; Derived by dev/extract_lightcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/lightcraft.edn"
  :app/upstream "https://github.com/storytold/lightcraft"}

 {:app/id "designcraft"
  :app/label "DesignCraft"
  :app/summary "Page layout (InDesign-style). Native: `designcraft --control PORT`; upstream docs use 7979, which collides with VectorCraft."
  :app/kind :native
  :app/transport :port
  :app/default-port 7981
  :app/port-env "DESIGNCRAFT_CONTROL_PORT"
  ;; Derived by dev/extract_designcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/designcraft.edn"
  :app/upstream "https://github.com/storytold/designcraft"}

 {:app/id "pdfcraft"
  :app/label "PdfCraft"
  :app/summary "Acrobat-style PDF reader/editor. Native: `pdfcraft --control <FILE>` (random port + token, ui.* methods); call runs ui.command {id}."
  :app/kind :native
  :app/transport :control-file
  ;; Live once configured: :apps {"pdfcraft" {:control-file "~/.pdfcraft-control.json"}}. The token is
  ;; read from that file per request and never logged or returned.
  ;; Derived by dev/extract_pdfcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/pdfcraft.edn"
  :app/upstream "https://github.com/storytold/pdfcraft"}

 {:app/id "studio"
  :app/label "ArtCraft Studio"
  :app/summary "AI image/video/3D studio (Tauri). Catalog-only: its #[tauri::command] fns are in-process webview IPC, with no external control surface."
  :app/kind :native
  :app/transport :none
  ;; Derived by dev/extract_studio.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/studio.edn"
  :app/upstream "https://github.com/storytold/artcraft"}

 {:app/id "filmcraft"
  :app/label "FilmCraft"
  :app/summary "Nonlinear video editor (Premiere-style). Native: `filmcraft --control PORT`. The static catalog lists cmd!/query! commands; wrapper macros and spec() helpers are counted under :unexpanded."
  :app/kind :native
  :app/transport :port
  :app/default-port 9876
  :app/port-env "FILMCRAFT_CONTROL_PORT"
  ;; FilmCraft's control port only listens when FILMCRAFT_CONTROL_TOKEN (64 hex) is set, and every
  ;; request must carry it as a top-level "token" (craft-libs control-protocol). Default reference;
  ;; override with :apps {"filmcraft" {:token-ref {:scheme :file :path ...}}}. Read per request,
  ;; never logged or returned.
  :app/token-ref {:scheme :env :name "FILMCRAFT_CONTROL_TOKEN"}
  ;; Derived by dev/extract_filmcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/filmcraft.edn"
  :app/upstream "https://github.com/storytold/filmcraft"}

 {:app/id "effectcraft"
  :app/label "EffectCraft"
  :app/summary "Motion graphics and compositing (After Effects-style). Native: `effectcraft --control PORT`. The static catalog lists cmd!/query! commands; wrapper macros are counted under :unexpanded."
  :app/kind :native
  :app/transport :port
  :app/default-port 9877
  :app/port-env "EFFECTCRAFT_CONTROL_PORT"
  ;; Derived by dev/extract_effectcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/effectcraft.edn"
  :app/upstream "https://github.com/storytold/effectcraft"}

 {:app/id "deckcraft"
  :app/label "DeckCraft"
  :app/summary "Presentations (PowerPoint-style). Native: `deckcraft --control PORT`; upstream docs use 7979/7990, which collide, so hive defaults to 7983."
  :app/kind :native
  :app/transport :port
  :app/default-port 7983
  :app/port-env "DECKCRAFT_CONTROL_PORT"
  ;; docs/control-protocol.md:1-21 describes no authentication (loopback only, bounded
  ;; connections), so no :app/token-ref.
  ;; Derived by dev/extract_deckcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/deckcraft.edn"
  :app/upstream "https://github.com/storytold/deckcraft"}

 {:app/id "gridcraft"
  :app/label "GridCraft"
  :app/summary "Spreadsheets (Excel-style). Native: `gridcraft --control PORT`. Every connection opens with an auth {token} handshake, which the socket transport sends from GRIDCRAFT_CONTROL_TOKEN or the token file the app writes."
  :app/kind :native
  :app/transport :port
  :app/default-port 7985
  :app/port-env "GRIDCRAFT_CONTROL_PORT"
  ;; docs/control-protocol.md:9-30 (crates/mcp/src/control_auth.rs token_path): the FIRST line of
  ;; every connection must be {"id":0,"method":"auth","params":{"token":...}}; the token is
  ;; GRIDCRAFT_CONTROL_TOKEN (>= 16 chars) or the 0600 file the app writes,
  ;; $XDG_RUNTIME_DIR/gridcraft/control-<port>.token (else ~/.cache/gridcraft/...). Read per
  ;; connection, never logged or returned.
  :app/auth {:mode :handshake :field "token"
             :ref {:scheme :env :name "GRIDCRAFT_CONTROL_TOKEN"}
             :file-pattern ["${XDG_RUNTIME_DIR}/gridcraft/control-{port}.token"
                            "${HOME}/.cache/gridcraft/control-{port}.token"]}
  ;; Derived by dev/extract_gridcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/gridcraft.edn"
  :app/upstream "https://github.com/storytold/gridcraft"}

 {:app/id "anicraft"
  :app/label "AniCraft"
  :app/summary "2D animation (Animate-style). Catalog-only: its automation is `anicraft-cli mcp`/`serve` on the child's stdin/stdout, with no external control surface a running app exposes."
  :app/kind :native
  :app/transport :none
  ;; Derived by dev/extract_anicraft.clj (CommandSpec registry + stdio MCP tools); :reference-revision
  ;; pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/anicraft.edn"
  :app/upstream "https://github.com/storytold/anicraft"}

 {:app/id "cadcraft"
  :app/label "CADCraft"
  :app/summary "2D drafting (AutoCAD-style). Native: `cadcraft --control PORT`. The static catalog lists CommandSpec::new builder chains; the gc!/dc! constraint macros are counted under :unexpanded."
  :app/kind :native
  :app/transport :port
  :app/default-port 7982
  :app/port-env "CADCRAFT_CONTROL_PORT"
  ;; CADCraft refuses (`unauthorized`) any request without the session token as a top-level
  ;; "token" (docs/control-protocol.md L12-18). The app issues it (64 hex) at startup into the
  ;; owner-only file $XDG_RUNTIME_DIR/cadcraft-control-<port>.token (else ~/.cache/...). Default
  ;; reference: export CADCRAFT_CONTROL_TOKEN from that file before starting hive, or point
  ;; :apps {"cadcraft" {:token-ref {:scheme :file :path "<that file>"}}} at it. Read per request,
  ;; never logged or returned.
  :app/token-ref {:scheme :env :name "CADCRAFT_CONTROL_TOKEN"}
  ;; Derived by dev/extract_cadcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/cadcraft.edn"
  :app/upstream "https://github.com/storytold/cadcraft"}

 {:app/id "figcraft"
  :app/label "FigCraft"
  :app/summary "Interface design and prototyping (Figma-style). Native: `figcraft --control PORT`; upstream docs use 7979, which collides with VectorCraft. The static catalog lists spec! commands."
  :app/kind :native
  :app/transport :port
  :app/default-port 7984
  :app/port-env "FIGCRAFT_CONTROL_PORT"
  ;; FigCraft's control port is loopback-only and unauthenticated (docs/control-protocol.md L10-16:
  ;; no token or key field); --automation-read-root/--automation-write-root confine its file access.
  ;; Derived by dev/extract_figcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/figcraft.edn"
  :app/upstream "https://github.com/storytold/figcraft"}

 {:app/id "wordcraft"
  :app/label "WordCraft"
  :app/summary "Word processor (Word-style). Native: `wordcraft --control PORT`; upstream docs use 7981, which collides with DesignCraft. The static catalog lists CommandSpec::new builder chains."
  :app/kind :native
  :app/transport :port
  :app/default-port 7986
  :app/port-env "WORDCRAFT_CONTROL_PORT"
  ;; WordCraft authenticates with a per-window KEY, not a token (docs/control-protocol.md L19-53,
  ;; crates/control-key/src/lib.rs): 256-bit hex written to <settings>/control-key.local-<port>,
  ;; <settings> = $WORDCRAFT_PROFILE_DIR, else $XDG_CONFIG_HOME/wordcraft, else ~/.config/wordcraft.
  ;; A new start writes a new key, so it is re-read per connection and sent as top-level "key" on
  ;; every request; WORDCRAFT_CONTROL_KEY overrides (as for wordcraft-cli mcp --connect).
  :app/auth {:mode :per-request :field "key"
             :ref {:scheme :env :name "WORDCRAFT_CONTROL_KEY"}
             :file-pattern ["${WORDCRAFT_PROFILE_DIR}/control-key.local-{port}"
                            "${XDG_CONFIG_HOME}/wordcraft/control-key.local-{port}"
                            "${HOME}/.config/wordcraft/control-key.local-{port}"]}
  ;; Derived by dev/extract_wordcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/wordcraft.edn"
  :app/upstream "https://github.com/storytold/wordcraft"}
 {:app/id "soundcraft"
  :app/label "SoundCraft"
  :app/summary "Digital audio workstation (Pro Tools-style). Native: `soundcraft --control PORT`. The static catalog lists cmd! commands; wrapper macros (toggle!, flag!, radio!, option!) are counted under :unexpanded. Its MCP tools are served by `soundcraft-cli mcp`, not by the app."
  :app/kind :native
  :app/transport :port
  :app/default-port 7987
  :app/port-env "SOUNDCRAFT_CONTROL_PORT"
  ;; docs/control-protocol.md:27-37 (Wire format): newline JSON on 127.0.0.1, engine.execute
  ;; {command, params}; no authentication, so no :app/token-ref.
  ;; Derived by dev/extract_soundcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/soundcraft.edn"
  :app/upstream "https://github.com/storytold/soundcraft"}

 {:app/id "materialcraft"
  :app/label "MaterialCraft"
  :app/summary "Node-based material authoring (Designer-style). Native: `materialcraft --control PORT`. Every connection opens with an auth {token} handshake (MATERIALCRAFT_CONTROL_TOKEN or the token file the app writes); engine commands go as command.run {id, params}."
  :app/kind :native
  :app/transport :port
  :app/default-port 7988
  :app/port-env "MATERIALCRAFT_CONTROL_PORT"
  ;; docs/control-protocol.md:12-24: the FIRST request must be {"method":"auth","params":{"token":...}};
  ;; the token is MATERIALCRAFT_CONTROL_TOKEN (16-1024 printable ASCII) or the 0600 file
  ;; <temp>/materialcraft-control-<port>.token (std::env::temp_dir = $TMPDIR or /tmp,
  ;; crates/automation/src/security.rs:28), one attempt within 10 s.
  :app/auth {:mode :handshake :field "token"
             :ref {:scheme :env :name "MATERIALCRAFT_CONTROL_TOKEN"}
             :file-pattern ["${TMPDIR:-/tmp}/materialcraft-control-{port}.token"]}
  ;; Engine commands go as command.run {id, params} on this port, not engine.execute.
  :app/call-method "command.run"
  ;; Derived by dev/extract_materialcraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/materialcraft.edn"
  :app/upstream "https://github.com/storytold/materialcraft"}

 {:app/id "texturecraft"
  :app/label "TextureCraft"
  :app/summary "3D texture painting (Painter-style). Native: `texturecraft --control PORT`. Every connection opens with an auth {token} handshake (TEXTURECRAFT_CONTROL_TOKEN or the token file the app writes); engine commands go as command.run {id, params}."
  :app/kind :native
  :app/transport :port
  :app/default-port 7989
  :app/port-env "TEXTURECRAFT_CONTROL_PORT"
  ;; docs/control-protocol.md:69-95: the first request on every connection must be
  ;; {"id":0,"method":"auth","params":{"token":...}}; the token is TEXTURECRAFT_CONTROL_TOKEN
  ;; (16-1024 printable ASCII) or a random 256-bit token the app writes to
  ;; <temp>/texturecraft-control-<port>.token ($TMPDIR or /tmp), owner-only (the bare token, not
  ;; pdfcraft's {port, token} JSON, so :transport :control-file does not fit).
  :app/auth {:mode :handshake :field "token"
             :ref {:scheme :env :name "TEXTURECRAFT_CONTROL_TOKEN"}
             :file-pattern ["${TMPDIR:-/tmp}/texturecraft-control-{port}.token"]}
  ;; Engine commands go as command.run {id, params} on this port, not engine.execute.
  :app/call-method "command.run"
  ;; Derived by dev/extract_texturecraft.clj; :reference-revision pins the clone HEAD.
  :app/catalog-resource "hive_artcraft/catalogs/texturecraft.edn"
  :app/upstream "https://github.com/storytold/texturecraft"}
]
