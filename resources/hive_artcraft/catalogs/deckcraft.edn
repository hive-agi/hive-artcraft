   "obj(\n                json!({\"path\": string(\"Image file path\"), \"data\": string(\"Base64 image data (instead of path)\"), \"name\": string(\"File name for data\"), \"x\": num(\"Left\"), \"y\": num(\"Top\"), \"w\": num(\"Width\"), \"h\": num(\"Height\")}),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "insert_table",
