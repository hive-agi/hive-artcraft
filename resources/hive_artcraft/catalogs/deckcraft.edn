 [{:name "list_commands",
   :title "List commands",
   :description
   "Every command (id, label, ribbon/menu place, shortcut, parameter summary, whether it is enabled now). Filter by a substring of id or label.",
   :input-schema-source
   "obj(json!({\"filter\": string(\"Substring of the id or label, e.g. `format.` or `slide`\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "run_command",
   :title "Run a command",
   :description
   "Run any command by id with JSON parameters. This is how everything is done: slide.new, shape.insert, text.set, format.bold, shape.fill, design.theme, transition.set, animation.add, table.merge, edit.undo…",
   :input-schema-source
   "obj(\n                json!({\"command\": string(\"Command id from list_commands\"), \"params\": {\"type\": \"object\", \"description\": \"Parameters (see the command's params summary)\"}}),\n                &[\"command\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "batch",
   :title "Run several commands",
   :description
   "Run commands in order; stops at the first error unless keepGoing. Returns each result.",
   :input-schema-source
   "obj(\n                json!({\"commands\": {\"type\": \"array\", \"items\": obj(json!({\"command\": string(\"id\"), \"params\": {\"type\": \"object\"}}), &[\"command\"])}, \"keepGoing\": boolean(\"Continue after errors\")}),\n                &[\"commands\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "new_presentation",
   :title "New presentation",
   :description
   "Start a new presentation (one title slide). Optional theme: DeckCraft, Harbor, Ember, Meadow, Nocturne, Paper, Coral Reef, Slate.",
   :input-schema-source
   "obj(json!({\"theme\": string(\"Theme name\"), \"blank\": boolean(\"No first slide\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "open_presentation",
   :title "Open presentation",
   :description "Open a .deckcraft or .pptx file by path.",
   :input-schema-source
   "obj(json!({\"path\": string(\"File path\")}), &[\"path\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "save_presentation",
   :title "Save presentation",
   :description
   "Save the active presentation (.deckcraft or .pptx by extension).",
   :input-schema-source
   "obj(json!({\"path\": string(\"File path (optional when it was opened from a file)\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "export",
   :title "Export",
   :description
   "Export slides: png/jpeg (one slide, or all with all:true), pptx, deckcraft, outline text, pdf (slides, notes pages or handouts), or an animated gif of the deck (one frame per slide).",
   :input-schema-source
   "obj(\n                json!({\n                    \"path\": string(\"Output path\"),\n                    \"format\": {\"type\": \"string\", \"enum\": [\"png\", \"jpeg\", \"pptx\", \"deckcraft\", \"outline\", \"rtf\", \"pdf\", \"gif\"], \"description\": \"Output format (default: from the path's extension)\"},\n                    \"slide\": int(\"Slide index for images\"),\n                    \"all\": boolean(\"All slides (images)\"),\n                    \"scale\": num(\"Pixels per point for images (default 2)\"),\n                    \"layout\": {\"type\": \"string\", \"enum\": [\"slides\", \"notes\", \"handouts\"], \"description\": \"PDF page layout (default slides)\"},\n                    \"perPage\": {\"type\": \"integer\", \"enum\": [1, 2, 3, 4, 6, 9], \"description\": \"PDF handouts: slides per page (default 6)\"},\n                    \"dpi\": num(\"PDF: raster resolution of slide artwork, 36-600 (default 200)\"),\n                    \"slides\": {\"type\": \"array\", \"items\": {\"type\": \"integer\", \"minimum\": 0}, \"description\": \"PDF and GIF: slide indices to export, in order (default all)\"},\n                    \"includeHidden\": boolean(\"PDF and GIF: include hidden slides (default false)\"),\n                    \"textLayer\": boolean(\"PDF: invisible text layer for search, select and copy (default true)\"),\n                    \"frame\": boolean(\"PDF notes/handouts: thin frame around each slide (default true)\"),\n                    \"paper\": {\"type\": \"string\", \"enum\": [\"letter\", \"a4\", \"legal\", \"a3\"], \"description\": \"PDF notes/handouts: paper size (default letter)\"},\n                    \"orientation\": {\"type\": \"string\", \"enum\": [\"portrait\", \"landscape\"], \"description\": \"PDF notes/handouts: page orientation (default portrait)\"},\n                    \"width\": {\n                        \"oneOf\": [\n                            {\"type\": \"integer\", \"minimum\": 16, \"maximum\": 3840},\n                            {\"type\": \"string\", \"enum\": [\"small\", \"medium\", \"large\", \"extraLarge\"]}\n                        ],\n                        \"description\": \"GIF: frame width in pixels, or a size: small 640, medium 960 (default), large 1280, extraLarge 1920; the height follows the slide's shape\"\n                    },\n                    \"secondsPerSlide\": {\"type\": \"number\", \"minimum\": 0.1, \"maximum\": 600, \"description\": \"GIF: seconds each slide shows (default 5)\"},\n                    \"loop\": boolean(\"GIF: loop forever (true, default) or play once (false)\")\n                }),\n                &[\"path\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_document",
   :title "Inspect presentation",
   :description
   "Slides (index, id, title, layout, shape count, transition, animations, notes), sections, theme, layouts, media and the selection.",
   :input-schema-source "obj(json!({}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_slide",
   :title "Inspect slide",
   :description
   "One slide's shapes with ids, kinds, boxes [x,y,w,h], placeholder types, text, fills, tables, charts; plus background, transition, animations, notes.",
   :input-schema-source
   "obj(json!({\"index\": int(\"Slide index (default: current)\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "render_slide",
   :title "Render slide",
   :description
   "Render a slide to a PNG image and return it, to check your work visually.",
   :input-schema-source
   "obj(\n                json!({\"slide\": int(\"Slide index (default: current)\"), \"scale\": num(\"Pixels per point (default 1 = 960×540 for 16:9)\"), \"edit\": boolean(\"Show placeholder prompts like the editor\")}),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "add_slide",
   :title "Add slide",
   :description
   "Insert a slide after the current one with a layout (title, titleAndContent, sectionHeader, twoContent, comparison, titleOnly, blank, contentWithCaption, pictureWithCaption) and optional title/body text (body: one paragraph per line, leading tabs indent).",
   :input-schema-source
   "obj(json!({\"layout\": string(\"Layout name or kind\"), \"title\": string(\"Title text\"), \"body\": string(\"Body text\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "go_to_slide",
   :title "Go to slide",
   :description
   "Make a slide current (shape commands act on the current slide).",
   :input-schema-source
   "obj(json!({\"index\": int(\"Slide index\")}), &[\"index\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "add_shape",
   :title "Add shape",
   :description
   "Insert a preset shape (rect, roundRect, ellipse, triangle, diamond, rightArrow, chevron, star5, heart, cloud, wedgeRectCallout, line, straightConnector1… see shape.presets) at x,y with size w×h, with optional text and fill colour (#RRGGBB or accent1..6).",
   :input-schema-source
   "obj(\n                json!({\"preset\": string(\"Preset name\"), \"x\": num(\"Left (pt)\"), \"y\": num(\"Top (pt)\"), \"w\": num(\"Width (pt)\"), \"h\": num(\"Height (pt)\"), \"text\": string(\"Text inside\"), \"fill\": string(\"Fill colour\"), \"line\": string(\"Outline colour or `none`\")}),\n                &[\"preset\", \"x\", \"y\", \"w\", \"h\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "add_text_box",
   :title "Add text box",
   :description "Insert a text box. Height grows to fit the text.",
   :input-schema-source
   "obj(\n                json!({\"x\": num(\"Left (pt)\"), \"y\": num(\"Top (pt)\"), \"w\": num(\"Width (pt)\"), \"h\": num(\"Height (pt)\"), \"text\": string(\"Text (one paragraph per line)\"), \"size\": num(\"Font size (pt)\"), \"color\": string(\"Text colour\"), \"align\": string(\"left|center|right|justify\")}),\n                &[\"x\", \"y\", \"w\", \"text\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "set_text",
   :title "Set text",
   :description
   "Replace a shape's text (keeps its first run's formatting). Leading tabs set bullet levels.",
   :input-schema-source
   "obj(json!({\"id\": int(\"Shape id (from inspect_slide)\"), \"text\": string(\"New text\")}), &[\"id\", \"text\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "insert_picture",
   :title "Insert picture",
   :description
   "Insert a picture from a file path or base64 data, optionally at a box.",
