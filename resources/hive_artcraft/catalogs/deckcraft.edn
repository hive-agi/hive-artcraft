   "obj(json!({\"ids\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}}}), &[\"ids\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "pointer",
   :title "Pointer gesture",
