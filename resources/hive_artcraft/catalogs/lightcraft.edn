 [{:name "command_list",
   :title "List commands",
   :description
   "Every command (engine + UI when connected) with id, label, menu, shortcut, parameter doc and whether it is enabled now. Each id is also callable as tool `cmd_<id with . replaced by _>` or via command_run.",
   :input-schema-source
   "json!({\n                \"filter\": {\"type\": \"string\", \"description\": \"Only commands whose id or label contains this text (case-insensitive)\"},\n                \"enabled_only\": {\"type\": \"boolean\", \"description\": \"Only commands that are enabled now\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "command_run",
   :title "Run command",
   :description
   "Run any LightCraft command by id with JSON params (see command_list for ids and parameter docs), e.g. {id: \"photo.rate\", params: {rating: 4}}.",
   :input-schema-source
   "json!({\"id\": {\"type\": \"string\", \"description\": \"Command id\"}, \"params\": {\"type\": \"object\", \"description\": \"Command parameters\", \"additionalProperties\": true}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "command_batch",
   :title "Run commands",
   :description
   "Run several commands in order: {steps: [{id, params?}], stop_on_error?: true}. Returns {completed, failed, results: [{ok, result | error}]}.",
   :input-schema-source
   "json!({\n                \"steps\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"params\": {\"type\": \"object\", \"additionalProperties\": true}}, \"required\": [\"id\"], \"additionalProperties\": false}},\n                \"stop_on_error\": {\"type\": \"boolean\", \"description\": \"Stop at the first failing step (default true)\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "doc_inspect",
   :title "Inspect library",
   :description
   "The library as JSON: current source, filter, sort, selection, active photo and undo/redo labels (library.state) plus counts (catalog.stats).",
   :input-schema-source "json!({})",
   :source "crates/mcp/src/tools.rs"}
  {:name "render_preview",
   :title "Render preview",
   :description
   "Render a photo with its current develop settings (cropped) and return it as an image (`max_side` is the long edge; does not change selection or save a file).",
   :input-schema-source
   "json!({\n                \"id\": {\"type\": \"integer\", \"description\": \"Photo id (default: the active photo); selection is unchanged\"},\n                \"max_side\": {\"type\": \"integer\", \"description\": \"Long edge in pixels (default 1024, max 4096)\"},\n                \"format\": {\"type\": \"string\", \"enum\": [\"png\", \"jpeg\"], \"description\": \"Image encoding (default png; jpeg is smaller)\"},\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "list_commands",
   :title "List commands",
   :description
   "Every command (engine + UI when connected) with id, label, menu, shortcut, parameter doc and whether it is enabled now. Each id is also callable as tool `cmd_<id with . replaced by _>` or via run_command.",
   :input-schema-source
   "json!({\"filter\": {\"type\": \"string\", \"description\": \"Only commands whose id or label contains this text (case-insensitive)\"}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "run_command",
   :title "Run command",
   :description
   "Run any LightCraft command by id with JSON params (see list_commands for ids and parameter docs), e.g. {command: \"photo.rate\", params: {rating: 4}}.",
   :input-schema-source
   "json!({\"command\": {\"type\": \"string\"}, \"params\": {\"type\": \"object\", \"description\": \"Command parameters\", \"additionalProperties\": true}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "import",
   :title "Import photos",
   :description
   "Add image/raw files to the library. Folders are scanned recursively for photos; relative paths resolve against the server's working directory. The first imported photo becomes active. Returns the new photo ids.",
   :input-schema-source
   "json!({\n                \"paths\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Files and/or folders\"},\n                \"album\": {\"type\": \"integer\", \"description\": \"Also add to this album id\"},\n                \"mode\": {\"type\": \"string\", \"enum\": [\"add\", \"copy\", \"move\"], \"description\": \"add (default) = reference the files in place; copy = copy them into `destination` (default: the library's Originals/); move = as copy, then each original and its XMP sidecars are removed from the source once the copy is verified and catalogued (duplicates and failures keep their sources; `kept` lists sources left in place and why; undo leaves the moved files at the destination)\"},\n                \"destination\": {\"type\": \"string\", \"description\": \"Copy or move: destination folder\"},\n                \"organize\": {\"type\": \"string\", \"description\": \"Copy or move: folders inside the destination — date (YYYY/YYYY-MM-DD, default), month (YYYY/YYYY-MM), flat, or a folder template such as {date:%Y}/{date:%Y%m%d} (→ 2026/20260114; the template's / make the levels, tokens as for rename; relative, no ..). Dated by capture time, else the import time\"},\n                \"onDeleted\": {\"type\": \"string\", \"enum\": [\"restore\", \"skip\", \"fresh\"], \"description\": \"A file that is in Recently Deleted: restore (default) = bring the photo back with its edits (`restored` lists it; relinked to the file when its own is gone); skip = leave it there (the duplicate is reported with existingDeleted); fresh = delete the trashed record and import the file as a new photo\"},\n                \"rename\": {\"type\": \"string\", \"description\": \"Copy or move: file-name template, e.g. {date:%Y%m%d_%H%M%S}_{seq:3} (run_command photo.renameTokens lists the tags); the extension is kept\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "query_photos",
   :title "Query photos",
   :description
   "List photos (id, file name, size, rating, flag, edited…). Without filter/sort: the current library view.",
   :input-schema-source
   "json!({\n                \"filter\": {\"type\": \"object\", \"description\": \"Catalog Filter JSON (e.g. {\\\"minRating\\\": 3})\", \"additionalProperties\": true},\n                \"sort\": {\"type\": \"object\", \"additionalProperties\": true},\n                \"offset\": {\"type\": \"integer\"},\n                \"limit\": {\"type\": \"integer\", \"description\": \"Default 200\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "select_photos",
   :title "Select photos",
   :description
   "Set the selection; the active photo (the one develop tools edit) is `active` or the first id.",
   :input-schema-source
   "json!({\"ids\": ids_schema(\"Photo ids\"), \"active\": {\"type\": \"integer\"}, \"mode\": {\"type\": \"string\", \"enum\": [\"replace\", \"add\", \"toggle\", \"range\"]}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "list_controls",
   :title "List develop controls",
   :description
   "Every develop slider (id like `light.exposure`, label, section, min, max, default, current value) for the active photo.",
   :input-schema-source
   "json!({\"section\": {\"type\": \"string\", \"description\": \"Only this section (e.g. light, color, effects, detail)\"}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "get_develop",
   :title "Get develop settings",
   :description
   "The full develop settings JSON of a photo (white balance, light, color, curves, mixer, grading, effects, crop, masks, spots…).",
   :input-schema-source
   "json!({\"id\": {\"type\": \"integer\", \"description\": \"Photo id (default: the active photo). Reads without changing the selection.\"}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "set_develop",
   :title "Set develop settings",
   :description
   "Edit a photo (one undo step each for values and settings). `values` sets sliders by control id (see list_controls), e.g. {\"light.exposure\": 0.7, \"light.contrast\": 20}. `settings` deep-merges a partial develop-settings JSON (as returned by get_develop).",
   :input-schema-source
   "json!({\n                \"id\": photo_id,\n                \"values\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\"}, \"description\": \"controlId → value\"},\n                \"settings\": {\"type\": \"object\", \"additionalProperties\": true, \"description\": \"Partial DevelopSettings JSON to merge\"},\n                \"label\": {\"type\": \"string\", \"description\": \"History label for `settings`\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "apply_preset",
   :title "Apply preset",
   :description
   "Apply a develop preset (ids from cmd_presets_list) to the selection or `ids`, at `amount` percent (0..200, default 100).",
   :input-schema-source
   "json!({\"preset\": {\"type\": \"string\", \"description\": \"Preset id\"}, \"amount\": {\"type\": \"number\"}, \"ids\": ids_schema(\"Photo ids (default: selection)\")})",
   :source "crates/mcp/src/tools.rs"}
  {:name "crop",
   :title "Crop / straighten",
   :description
   "Set the crop of the active photo: `rect` [x0,y0,x1,y1] in normalized coordinates (0..1, origin top-left) of the straightened frame, `angle` in degrees. `reset: true` clears it. Give at least one of them.",
   :input-schema-source
   "json!({\"id\": photo_id, \"rect\": {\"type\": \"array\", \"items\": {\"type\": \"number\"}, \"minItems\": 4, \"maxItems\": 4}, \"angle\": {\"type\": \"number\"}, \"reset\": {\"type\": \"boolean\"}})",
   :source "crates/mcp/src/tools.rs"}
  {:name "render_photo",
   :title "Render photo",
   :description
   "Render a photo with its current develop settings (cropped) and return it as an image so you can look at the result.",
   :input-schema-source
   "json!({\n                \"id\": {\"type\": \"integer\", \"description\": \"Photo id (default: the active photo); selection is unchanged\"},\n                \"size\": {\"type\": \"integer\", \"description\": \"Long edge in pixels (default 1024, max 4096)\"},\n                \"format\": {\"type\": \"string\", \"enum\": [\"png\", \"jpeg\"], \"description\": \"Image encoding (default png; jpeg is smaller)\"},\n                \"path\": {\"type\": \"string\", \"description\": \"Also save the rendered file here\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "export",
   :title "Export photo",
   :description
   "Render and write photos. Give `path` (one photo; format from the extension unless `format` is set) or `dir` (batch, file names from `naming`).",
   :input-schema-source
   "json!({\n                \"id\": photo_id,\n                \"ids\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}, \"description\": \"Photos to export (default: the given/active photo)\"},\n                \"path\": {\"type\": \"string\"},\n                \"dir\": {\"type\": \"string\"},\n                \"preset\": {\"type\": \"string\", \"description\": \"Export preset id or name\"},\n                \"background\": {\"type\": \"boolean\", \"description\": \"Desktop background export (headless exports remain blocking)\"},\n                \"resize\": {\"type\": \"object\", \"description\": \"Full Resize options; alternatively use the size helpers below\"},\n                \"destinationMode\": {\"type\": \"string\", \"enum\": [\"specificFolder\", \"sameAsOriginal\"], \"description\": \"specificFolder (default) = everything into `dir`; sameAsOriginal = each photo into the folder of its original (+ `subfolder`); a photo with no folder on disk (demo, browser) or whose folder is gone gets an error\"},\n                \"subfolder\": {\"type\": \"string\", \"description\": \"Created inside the destination folder\"},\n                \"conflict\": {\"type\": \"string\", \"enum\": [\"unique\", \"overwrite\", \"skip\"]},\n                \"tiffCompression\": {\"type\": \"string\", \"enum\": [\"none\", \"lzw\", \"zip\"]},\n                \"dngCompression\": {\"type\": \"string\", \"enum\": [\"lossless\", \"deflate\", \"uncompressed\", \"lossy\"]},\n                \"format\": {\"type\": \"string\", \"enum\": [\"jpeg\", \"png\", \"tiff\", \"psd\", \"webp\", \"avif\", \"jxl\", \"original\", \"dng\", \"rendereddng\"], \"description\": \"psd = a flat PSD (no layers); rendereddng = Render to DNG, a linear 16-bit float DNG of the rendered photo with the edit baked in; original = the file as is + an XMP sidecar with the edits; dng = raw photos as DNG with the edits embedded\"},\n                \"longEdge\": {\"type\": \"integer\", \"description\": \"Output long edge in px. When no size param is given: 3000; 0 = full size (cropped, native resolution)\"},\n                \"shortEdge\": {\"type\": \"integer\", \"description\": \"Output short edge in px\"},\n                \"width\": {\"type\": \"integer\", \"description\": \"Output width in px (with height: fit inside width × height, either orientation)\"},\n                \"height\": {\"type\": \"integer\", \"description\": \"Output height in px\"},\n                \"megapixels\": {\"type\": \"number\", \"description\": \"Output size in megapixels\"},\n                \"percent\": {\"type\": \"number\", \"description\": \"Output size as a percentage of full size\"},\n                \"dontEnlarge\": {\"type\": \"boolean\", \"description\": \"Never upscale past the photo's own size (default true)\"},\n                \"ppi\": {\"type\": \"integer\", \"description\": \"Print resolution written into the file (default 240)\"},\n                \"quality\": {\"type\": \"integer\", \"description\": \"JPEG/AVIF/lossy JPEG XL quality 1..100\"},\n                \"jxlLossless\": {\"type\": \"boolean\", \"description\": \"JPEG XL: mathematically lossless (quality unused); default false\"},\n                \"jxlEffort\": {\"type\": \"string\", \"enum\": [\"fast\", \"normal\"], \"description\": \"JPEG XL encoder effort: normal (default) makes files about a quarter smaller than fast, in about twice the time\"},\n                \"jxlProgressive\": {\"type\": \"boolean\", \"description\": \"JPEG XL: progressive file, a coarse image first (default false)\"},\n                \"limitKb\": {\"type\": \"integer\", \"description\": \"JPEG: largest quality that fits this many KB\"},\n                \"sharpen\": {\"type\": \"string\", \"enum\": [\"none\", \"screen\", \"matte\", \"glossy\"]},\n                \"sharpenAmount\": {\"type\": \"string\", \"enum\": [\"low\", \"standard\", \"high\"]},\n                \"naming\": {\"type\": \"string\", \"description\": \"File-name template, e.g. {name}-{seq} or {date:%Y-%m-%d}_{title}_{seq:2} (tokens: {name} {num} {seq} {seq:N} {date} {date:%…} {folder} {camera} {lens} {iso} {rating} {title} {creator} {ext})\"},\n                \"startNumber\": {\"type\": \"integer\", \"description\": \"First {seq} value (default 1)\"},\n                \"metadata\": {\"type\": \"string\", \"enum\": [\"all\", \"allExceptCamera\", \"copyright\", \"none\"]},\n                \"removeLocation\": {\"type\": \"boolean\"},\n                \"colorSpace\": {\"type\": \"string\", \"enum\": [\"srgb\", \"displayP3\", \"adobeRgb\", \"proPhoto\", \"rec2020\"], \"description\": \"Output colour space (default sRGB; AVIF is always sRGB; lossy JPEG XL writes adobeRgb/proPhoto as rec2020). adobeRgb = Adobe RGB (1998) compatible; the embedded ICC profile is generated from the published primaries\"},\n                \"bitDepth\": {\"type\": \"integer\", \"enum\": [8, 10, 16, 32], \"description\": \"Bits per channel: PNG 8|16 (default 8), TIFF 8|16|32 (default 16; 32 = linear float with a linear profile), PSD 8|16 (default 16), AVIF 8|10, JPEG XL 8|16; JPEG/WebP are 8-bit\"},\n                \"hdr\": {\"type\": \"boolean\", \"description\": \"HDR output for photos edited in HDR (develop.hdr): JPEG as an ISO 21496-1 gain map JPEG, AVIF as 10-bit, PNG and JPEG XL as 16-bit Rec. 2020 PQ, 32-bit TIFF with highlights above 1; other formats and SDR edits export as usual\"},\n                \"hdrTransfer\": {\"type\": \"string\", \"enum\": [\"pq\", \"hlg\"], \"description\": \"Transfer curve of HDR AVIF output (default pq): pq = SMPTE ST 2084, hlg = ITU-R BT.2100 hybrid log-gamma\"},\n                \"addToPhotos\": {\"type\": \"boolean\", \"description\": \"macOS: after writing the files, add them to Apple Photos (Apple Events to Photos' import; the first time, macOS asks the user to allow LightCraft to control Photos). The outcome is `applePhotos` in the result, the import job: {job, running, requested, album, imported?, ids?, warning?, error?}; headless waits for Photos, the desktop app returns the running job (outcome: command export.photosImports {job}). The files are written either way. An error before exporting on other platforms, or while another import is reserved or running\"},\n                \"photosAlbum\": {\"type\": \"string\", \"description\": \"With addToPhotos: the album to add them to, a top-level Photos album of exactly this name, made when missing (several of that name: nothing is added); default none\"},\n                \"watermark\": {\"description\": \"Text, or {text, vertical (boolean; defaults to false: upright columns right to left), size (text height as a fraction of the short edge, 0.005..0.5; default 0.035), opacity (0..1; default 0.7), anchor (topLeft|top|topRight|left|center|right|bottomLeft|bottom|bottomRight), insetX (margin from the left or right edge as a fraction of the short edge, 0..0.4; default 0.025), insetY (margin from the top or bottom edge, same units), inset (sets both), rotation (degrees clockwise: 0|90|180|270; default 0; the watermark is sized before it is turned), color [r,g,b] (sRGB 0..255), shadow (boolean), image (path of a graphic drawn instead of the text), imageWidth (fraction of the photo's width, 0.01..1; default 0.2)}. Unknown keys and out-of-range sizes are errors\"}\n            })",
   :source "crates/mcp/src/tools.rs"}
  {:name "ui_inspect",
