 [{:name "list_commands",
   :title "List commands",
   :description
   "\"List DesignCraft commands: id, label, menu path, shortcut, parameter description and whether it can run right now. \\\n             Every user-visible action is a command (frame.create, text.insert, type.char, style.paragraph.apply, layout.pages.insert, \\\n             object.fill, transform.move, edit.undo…); run them with execute or batch.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"filter\": string(\"Case-insensitive substring matched against id, label and menu path (e.g. \\\"frame\\\", \\\"style\\\", \\\"Layout\\\")\"),\n                    \"enabledOnly\": boolean(\"Only commands that can run right now\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "execute",
   :title "Execute command",
   :description
   "\"Run any DesignCraft command by id with JSON params (ids and params from list_commands). Examples: \\\n             {\\\"command\\\":\\\"frame.create\\\",\\\"params\\\":{\\\"rect\\\":[36,36,576,300],\\\"content\\\":\\\"text\\\",\\\"text\\\":\\\"Hello\\\"}} → {id, story}; \\\n             {\\\"command\\\":\\\"type.char\\\",\\\"params\\\":{\\\"size\\\":24}}; {\\\"command\\\":\\\"edit.undo\\\"}. Coordinates are points in spread space. \\\n             In the desktop app the UI-only commands (view.*, window.*, help.*, edit.dynamicSpelling, and app.* except app.links, \\\n             which works everywhere) work too.\"",
   :input-schema-source
   "obj(json!({\"command\": string(\"Command id, e.g. frame.create\"), \"params\": params_schema()}), &[\"command\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "batch",
   :title "Execute commands",
   :description
   "\"Run several commands in order, stopping at the first error. Returns each result; on failure also the failing index \\\n             and message (earlier commands stay applied; use edit.undo to revert them). Later steps can use earlier results: a \\\n             parameter string \\\"$N.path\\\" is replaced by that value of step N's result (0-based; \\\"$last.path\\\" for the previous \\\n             step), e.g. after frame.create → {\\\"id\\\": 8, \\\"story\\\": 9}, {\\\"story\\\": \\\"$0.story\\\"} passes 9; \\\"${N.path}\\\" \\\n             interpolates into longer strings. Other strings starting with $ stay as written; \\\"$$\\\" is a literal $ \\\n             (\\\"$$1\\\" passes the GREP group $1). Give `commands`, or `script` text (one `command.id {json}` per line).\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"commands\": {\n                        \"type\": \"array\",\n                        \"minItems\": 1,\n                        \"description\": \"Commands to run in order\",\n                        \"items\": obj(json!({\"command\": string(\"Command id\"), \"params\": params_schema()}), &[\"command\"]),\n                    },\n                    \"script\": string(\"Alternative to `commands`: lines of `command.id {json params}` (# comments allowed)\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_document",
   :title "Inspect document",
   :description
   "\"Summary of the active document: settings, pages (index, name, bounds, margins, columns), spreads with items (id, kind, \\\n             bounds, fill, stroke, story), stories (id, frames, length in UTF-8 bytes, overset, preview), layers, \\\n             paragraph/character styles, swatches, selection, active tool.\"",
   :input-schema-source "empty()",
   :source "crates/mcp/src/tools.rs"}
  {:name "get_story",
   :title "Get story",
   :description
   "\"Full text of a story plus its length, frames, paragraph count, line count and overset position (length and positions \\\n             are UTF-8 byte offsets, the unit text.select takes). Identify it by `story` id or by a text `frame` id (default: the \\\n             selection).\"",
   :input-schema-source
   "obj(json!({\"story\": int(\"Story id\"), \"frame\": int(\"Text frame id\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "set_story_text",
   :title "Set story text",
   :description
   "\"Replace the whole text of a story (keeps the first paragraph's and character's formatting). Use \\\\n for paragraph breaks. \\\n             Identify the story by `story` id or by a text `frame` id.\"",
   :input-schema-source
   "obj(json!({\"story\": int(\"Story id\"), \"frame\": int(\"Text frame id\"), \"text\": string(\"New text\")}), &[\"text\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "new_document",
   :title "New document",
   :description
   "\"Create a new document and make it active. Sizes are in points (72 pt = 1 in). sample:true opens the multi-page \\\n             magazine sample instead.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"preset\": string(\"Page size preset, e.g. \\\"Letter\\\", \\\"A4\\\", \\\"Tabloid\\\"\"),\n                    \"width\": num(\"Page width (pt)\"),\n                    \"height\": num(\"Page height (pt)\"),\n                    \"pages\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"Number of pages\"},\n                    \"facingPages\": boolean(\"Facing pages (spreads)\"),\n                    \"columns\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"Column count\"},\n                    \"gutter\": num(\"Column gutter (pt)\"),\n                    \"margins\": {\"description\": \"Uniform margin (pt) or {top, bottom, inside, outside}\", \"anyOf\": [{\"type\": \"number\"}, {\"type\": \"object\"}]},\n                    \"bleed\": {\"description\": \"Bleed on all sides (pt) or [top, bottom, inside, outside]\", \"anyOf\": [{\"type\": \"number\"}, {\"type\": \"array\", \"items\": {\"type\": \"number\"}}]},\n                    \"title\": string(\"Document title\"),\n                    \"intent\": {\"type\": \"string\", \"enum\": [\"print\", \"web\", \"mobile\"], \"description\": \"Document intent\"},\n                    \"units\": string(\"Ruler units, e.g. \\\"points\\\", \\\"picas\\\", \\\"millimeters\\\"\"),\n                    \"startPage\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"Number of the first page\"},\n                    \"slug\": {\"description\": \"Slug on all sides (pt) or [top, bottom, inside, outside]\", \"anyOf\": [{\"type\": \"number\"}, {\"type\": \"array\", \"items\": {\"type\": \"number\"}}]},\n                    \"primaryTextFrame\": boolean(\"Put a primary text frame on the parent page\"),\n                    \"sample\": boolean(\"Open the sample magazine instead\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "open_document",
   :title "Open document",
   :description "Open a .designcraft file as a new, active document.",
   :input-schema-source
   "obj(json!({\"path\": string(\"File path\")}), &[\"path\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "save_document",
   :title "Save document",
   :description
   "Save the active document in the native .designcraft format.",
   :input-schema-source
   "obj(json!({\"path\": string(\"Destination (default: the document's current path)\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "place_image",
   :title "Place image",
   :description
   "\"Place an image (PNG, JPEG, WebP, GIF, TIFF) from a file `path` or `base64` data. It goes into `frame` (or the selected \\\n             empty/graphic frame), otherwise into a new frame at x, y (default: the page's top-left margin) with an optional width.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"path\": string(\"Image file path\"),\n                    \"base64\": string(\"Image bytes, base64 (alternative to path)\"),\n                    \"name\": string(\"Name for base64 images\"),\n                    \"frame\": int(\"Frame id to place into\"),\n                    \"spread\": int(\"Spread index for a new frame (default 0)\"),\n                    \"x\": num(\"Left of the new frame (spread pt)\"),\n                    \"y\": num(\"Top of the new frame (spread pt)\"),\n                    \"width\": num(\"Width of the new frame (pt); height follows the aspect ratio\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "render_page",
   :title "Render page",
   :description
   "\"Render one page of the active document (printing items only, like Preview) and return it as a PNG image. Optionally \\\n             also write it to `path`.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"page\": {\"type\": \"integer\", \"minimum\": 0, \"description\": \"Page index, 0-based (default 0; in the desktop app default = the current page)\"},\n                    \"scale\": num(\"Pixels per point (default 1 = 72 ppi)\"),\n                    \"bleed\": boolean(\"Include the bleed area\"),\n                    \"path\": string(\"Also write the PNG here\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "export_png",
   :title "Export PNG",
   :description
   "Export one page as a PNG (or JPEG if the path ends in .jpg) file. Returns the path and pixel size.",
   :input-schema-source
   "obj(\n                json!({\"path\": string(\"Destination file\"), \"page\": {\"type\": \"integer\", \"minimum\": 0, \"description\": \"Page index, 0-based (default 0; in the desktop app default = the current page)\"}, \"scale\": num(\"Pixels per point (default 2)\")}),\n                &[\"path\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "screenshot",
   :title "Screenshot",
   :description &app_only,
   :input-schema-source
   "obj(json!({\"path\": string(\"Also write the PNG here\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "select_tool",
   :title "Select tool",
   :description
   "\"Switch the active tool (as clicking it in the Tools panel). Ids: selection, directSelection, type, rectangleFrame, \\\n             ellipseFrame, polygonFrame, rectangle, ellipse, polygon, line, hand, zoom, …\"",
   :input-schema-source
   "obj(json!({\"tool\": string(\"Tool id\")}), &[\"tool\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "pointer",
   :title "Pointer gesture",
   :description
   "\"Drive the active tool with mouse events, exactly like the mouse would. Coordinates are spread points (space \\\"doc\\\", \\\n             default) or, in the desktop app, screen points (space \\\"screen\\\"). Example: a text frame with the type tool: \\\n             {tool:\\\"type\\\", events:[{kind:\\\"down\\\",x:72,y:72},{kind:\\\"drag\\\",x:300,y:200},{kind:\\\"up\\\",x:300,y:200}]} leaves a caret \\\n             in the new frame, ready for type_text. Returns the selection and the active tool.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"tool\": string(\"Optional tool to select before the gesture\"),\n                    \"events\": {\n                        \"type\": \"array\",\n                        \"minItems\": 1,\n                        \"items\": obj(json!({\n                            \"kind\": {\"type\": \"string\", \"enum\": [\"down\", \"drag\", \"up\", \"move\", \"doubleclick\"]},\n                            \"x\": num(\"x (pt)\"),\n                            \"y\": num(\"y (pt)\"),\n                            \"space\": {\"type\": \"string\", \"enum\": [\"doc\", \"screen\"], \"description\": \"Coordinate space (default doc)\"},\n                            \"mods\": mods_schema(),\n                            \"clicks\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"On a down: presses in a row it completes (2 double, 3 triple…; default 1)\"},\n                        }), &[\"kind\", \"x\", \"y\"]),\n                    },\n                    \"mods\": mods_schema(),\n                }),\n                &[\"events\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "key",
   :title "Press key",
   :description
   "\"Press a key with modifiers, e.g. {key:\\\"Z\\\", cmd:true} (undo), {key:\\\"Escape\\\"}, {key:\\\"Enter\\\"}, {key:\\\"Left\\\", shift:true}. \\\n             In the desktop app it goes through the real keyboard path; headless it goes to the active tool (caret keys while typing), \\\n             then command shortcuts, then tool shortcuts.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"key\": string(\"Key name: A–Z, 0–9, Enter, Escape, Delete, Backspace, Tab, Space, Left/Right/Up/Down, Home, End, [ ] …\"),\n                    \"shift\": {\"type\": \"boolean\"}, \"alt\": {\"type\": \"boolean\"}, \"cmd\": {\"type\": \"boolean\"}, \"ctrl\": {\"type\": \"boolean\"},\n                }),\n                &[\"key\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "type_text",
   :title "Type text",
   :description
   "\"Type text at the text insertion point, independently of the active tool, or into the focused dialog field in \\\n             the desktop app. Put a caret first with pointer (tool \\\"type\\\") or execute text.placeCaret / text.select.\"",
   :input-schema-source
   "obj(json!({\"text\": string(\"Text to type (\\\\n = new paragraph)\")}), &[\"text\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "ime",
   :title "Input method",
   :description
   "\"Input method (IME) events at the Type tool's caret, as a system IME sends them: `preedit` is the marked text \\\n             (shown in place, no undo step; an empty string cancels the composition), `active` the clause being converted \\\n             in characters of it, `commit` the text the IME types in its place (one undo step). Example, Japanese: \\\n             {preedit:\\\"にほん\\\", active:[3,3]} then {preedit:\\\"日本\\\", active:[0,2]} then {commit:\\\"日本\\\"}. Returns \\\n             whether a composition is still open.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"preedit\": string(\"Marked text (replaces the previous marked text; empty = cancel)\"),\n                    \"active\": {\"type\": \"array\", \"items\": {\"type\": \"integer\", \"minimum\": 0}, \"minItems\": 2, \"maxItems\": 2,\n                               \"description\": \"[start, end] of the clause being converted, in characters of preedit (start = end: the IME's cursor)\"},\n                    \"commit\": string(\"Committed text, typed in place of the marked text\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "click",
   :title "Click",
   :description &app_only,
   :input-schema-source
   "obj(\n                json!({\n                    \"x\": num(\"Screen x\"), \"y\": num(\"Screen y\"),\n                    \"button\": {\"type\": \"string\", \"enum\": [\"left\", \"right\"], \"description\": \"Default left\"},\n                    \"count\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"2 = double-click\"},\n                    \"shift\": {\"type\": \"boolean\"}, \"alt\": {\"type\": \"boolean\"}, \"cmd\": {\"type\": \"boolean\"}, \"ctrl\": {\"type\": \"boolean\"},\n                }),\n                &[\"x\", \"y\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "drag",
   :title "Drag",
   :description &app_only,
   :input-schema-source
   "obj(\n                json!({\n                    \"x\": num(\"Start x\"), \"y\": num(\"Start y\"), \"toX\": num(\"End x\"), \"toY\": num(\"End y\"),\n                    \"steps\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"Intermediate moves (default 8)\"},\n                    \"button\": {\"type\": \"string\", \"enum\": [\"left\", \"right\"], \"description\": \"Default left\"},\n                    \"shift\": {\"type\": \"boolean\"}, \"alt\": {\"type\": \"boolean\"}, \"cmd\": {\"type\": \"boolean\"}, \"ctrl\": {\"type\": \"boolean\"},\n                }),\n                &[\"x\", \"y\", \"toX\", \"toY\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "menu_list",
