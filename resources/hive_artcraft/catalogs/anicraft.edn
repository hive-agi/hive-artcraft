   "{color: \"#rrggbb\", layer?} the layer's colour: its outlines in outline mode and its bar on the timeline",
   :source "crates/engine/src/cmds_layer.rs"}
  {:id "layer.set_depth",
   :label "Layer Depth",
   :params
   "{depth (px behind the stage, −500…10000; through the camera a deeper layer moves and scales less, and draws behind nearer ones), layer?, key?: bool (default: whether the layer's depth is keyed), frame? (default: the playhead)} with `key` sets a depth key at the frame (the first key away from frame 0 also keys frame 0 with the depth it had), so the depth tweens linearly between keys; `key: false` makes the depth one value again (ADR 0082)",
   :source "crates/engine/src/cmds_camera.rs"}
  {:id "layer.set_height",
   :label "Layer Height",
   :params
   "{height: 100 | 200 | 300 (percent of a normal row), layer?} the layer's row height on the timeline",
   :source "crates/engine/src/cmds_layer.rs"}
  {:id "layer.set_mask",
   :label "Mask Type",
   :params
   "{mask: coverage|alpha|luminance, layer?} how a mask layer reveals the layers it masks: coverage (its fills' area), alpha (its artwork's opacity: gradients and faded shapes make soft edges) or luminance (its brightness: white shows, black hides; SVG's mask) (ADR 0070)",
   :source "crates/engine/src/cmds_layer.rs"}
  {:id "layer.set_onion",
   :label "Onion Skin Layer",
   :params
   "{onion?: bool (default: the other way), solo?: bool, layer?} whether onion skin draws the layer's frames around the playhead. solo: only this layer is onion-skinned (every other layer off); solo again on the only layer on turns them all back on (Alt-click)",
   :source "crates/engine/src/cmds_layer.rs"}
  {:id "layer.set_properties",
   :label "Layer Properties",
   :params
   "{layer?, name?, type?: normal|mask|masked|guide|guided, mask?: coverage|alpha|luminance (a mask layer's mask type), color?, outline?: bool (view as outlines), height?: 100|200|300, visible?, locked?, onion?} sets several at once, as one undo step; answers with the layer's properties",
   :source "crates/engine/src/cmds_layer.rs"}
  {:id "layer.set_type",
   :label "Layer Type",
   :params "{type: normal|mask|masked|guide|guided, layer?}",
   :source "crates/engine/src/cmds_timeline.rs"}
  {:id "layer.set_volume",
   :label "Layer Volume",
   :params
   "{volume? (0–1: the layer's sounds and those in the symbols on it), muted?, layer?}",
   :source "crates/engine/src/cmds_sound.rs"}
  {:id "layer.toggle_lock",
   :label "Lock/Unlock Layer",
   :params "{layer?}",
   :source "crates/engine/src/cmds_timeline.rs"}
  {:id "layer.toggle_mask",
   :label "Mask",
   :params "{layer?}",
   :source "crates/engine/src/cmds_timeline.rs"}
  {:id "layer.toggle_mute",
   :label "Mute/Unmute Layer",
   :params
   "{layer?} (its sounds, and those in the symbols on it, go silent in playback and every export)",
   :source "crates/engine/src/cmds_sound.rs"}
  {:id "layer.toggle_outline",
   :label "Outline Layer",
   :params "{layer?}",
   :source "crates/engine/src/cmds_timeline.rs"}
  {:id "layer.toggle_visible",
   :label "Show/Hide Layer",
   :params "{layer?}",
   :source "crates/engine/src/cmds_timeline.rs"}
  {:id "library.delete",
   :label "Delete",
   :params
   "{items: [{symbol | bitmap | sound | folder: id}, ..]} deletes items and folders with everything in them; instances of deleted symbols, shapes filled with deleted bitmaps and keyframes' deleted sounds go too (asks first when anything deleted is in use or a folder isn't empty)",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.delete_unused",
   :label "Delete Unused Items",
   :params "{} deletes every item `library.unused` lists (asks first)",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.duplicate",
   :label "Duplicate Symbol",
   :params
   "{symbol, name? (default: “<name> copy”)} → {symbol, name}: a copy in the same folder, with its own layers and elements and no linkage class",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.items",
   :label "List Library",
   :params
   "{} every folder (id, name, parent, path) and item (symbol | bitmap | sound id, kind, name, folder, path, uses, unused) in Library order; `uses` counts instances, bitmap fills and keyframe sounds once per keyframe",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.move",
   :label "Move to Folder",
   :params
   "{items: [{symbol | bitmap | sound | folder: id}, ..], to: folder id | null (the top level)} moves items and folders (with what they hold) into a folder; a folder can't go inside itself, and a name the folder already has stops the move",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.new_folder",
   :label "New Folder",
   :params
   "{name? (default: the next free “Folder n”), parent?: folder id} → {folder, name}; names are unique within a folder (case aside) and can't hold “/”",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.place",
   :label "Place on Stage",
   :params
   "{symbol | bitmap | sound: id, x?, y?} or {items: [{symbol | bitmap | sound: id}, ..], x?, y?} → {element, elements, sound?}: symbols and bitmaps centred on x, y (default: the stage centre; inside an open symbol, in its space) in the active layer's keyframe at the playhead, selected; a sound goes onto that keyframe, its span grown to fit (one sound per keyframe). One undo step",
   :source "crates/engine/src/cmds_draw.rs"}
  {:id "library.rename",
   :label "Rename",
   :params
   "{symbol | bitmap | sound | folder: id, name} renames a Library item or folder; the name must be free in its folder (case aside) and can't hold “/”",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.set_smoothing",
   :label "Allow Smoothing",
   :params
   "{bitmap, on?: bool (default: toggle)} whether the bitmap is filtered when scaled or turned (off: hard-edged pixels)",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "library.unused",
   :label "Select Unused Items",
   :params
   "{} → {items: [..]} the items nothing in the movie reaches: not in a scene, nor inside a symbol that is; symbols with a linkage class count as used",
   :source "crates/engine/src/cmds_library.rs"}
  {:id "macro.delete",
   :label "Delete Saved Command",
   :params
   "{folder, name, confirm}: deletes a saved command's file (cannot be undone)",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.history",
   :label "List History Steps",
   :params
   "{} → {steps: [{index, label, undone, keep, commands?, why?, rewritten?}]}: every undo-history step as Save As Command keeps it: `keep` false says `why` it can't be kept; `rewritten` names params dropped so the step acts on the selection or active layer",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.import",
   :label "Add Saved Command from File",
   :params
   "{folder, path (a saved command's file), name? (default: the file's), confirm? (to replace one of that name)} → {name, path, steps}: checks it and copies it in, last in the list",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.list",
   :label "Manage Saved Commands…",
   :params
   "{folder} → {commands: [{name, path, steps}], problems: [{file, error}]}: the saved commands in the folder, in their order (the app shows them in a window)",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.move",
   :label "Move Saved Command",
   :params
   "{folder, name, index (its new place in the list, 0-based)}",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.rename",
   :label "Rename Saved Command",
   :params
   "{folder, name, to} → {name, from, path}: renames a saved command (its file); its place in the list stays",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.run",
   :label "Run Command…",
   :params
   "{name + folder (a saved command) | path (a saved command's file, or a JSON array of {cmd, params}) | steps: [{cmd, params?, label?}], name? (for steps)} → {name, steps, results}: runs the steps in order as one undo step named after it. At the first step that fails nothing is changed and the error names the step. Steps may call what a plug-in may, never macro.*",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "macro.save",
   :label "Save As Command…",
   :params
   "{folder, name, history: [index, ..] (as macro.history lists them) | steps: [{cmd, params?, label?}], confirm? (to replace a saved command of that name)} → {name, path, steps, rewritten}: keeps the steps as <folder>/<name>.json, last in the list",
   :source "crates/engine/src/cmds_macro.rs"}
  {:id "modify.break_apart",
   :label "Break Apart",
   :params
   "{} the selected symbol instances become their contents, text becomes shapes, and drawing objects become raw shapes that merge with the raw shapes they touch",
   :source "crates/engine/src/cmds_draw.rs"}
  {:id "modify.combine",
   :label "Combine Objects",
   :params
   "{op: union|intersect|punch|crop} combines the selected shapes on the active layer, bottom to top as they are stacked (ADR 0073). union: one drawing object of everything (a group of the merged pieces when they have more than one colour or keep lines); intersect: the area every one covers, in the topmost's fill and stroke; punch: the topmost's area cut out of each of the others; crop: each of the others cut to the topmost's area. Punch and crop remove the topmost. A result of one fill (or one line) is a drawing object, one of several is a group of raw shapes → {op, created}",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "modify.convert_to_symbol",
   :label "Convert to Symbol…",
   :params
   "{name? (default: the next free “Symbol n”; a name the folder holds gets a number), kind?: graphic|movie_clip|button (default: graphic), folder?: Library folder id (default: the top level)} → {symbol, instance, name, layer, folder} (a selection on several layers becomes one symbol with those layers inside; the instance lands on the topmost)",
   :source "crates/engine/src/cmds_draw.rs"}
  {:id "modify.crop",
   :label "Crop",
   :params "{} combine with op crop",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "modify.envelope",
   :label "Envelope",
   :params
   "{} opens an envelope around the selected shapes and drawing objects on the active layer (ADR 0080): a mesh of 4 × 4 Bézier control points over their bounds, at rest → {points: [[x, y] × 16] (row by row from the top-left), bounds: [x, y, w, h], shapes}. Then modify.envelope_move bends them. Symbols, text, groups and bitmaps can't be bent: break them apart first",
   :source "crates/engine/src/cmds_envelope.rs"}
  {:id "modify.envelope_close",
   :label "Close Envelope",
   :params
   "{} closes the open envelope: bent raw shapes merge with the drawing they now touch (as after a move). Nothing to close is no error → {closed}",
   :source "crates/engine/src/cmds_envelope.rs"}
  {:id "modify.envelope_move",
   :label "Envelope",
   :params
   "{points: [[x, y] × 16] (the whole mesh) | index: 0..15, x, y (one control point; a corner or side handle moves the inner points with it, as a Coons patch), tolerance? (stage units, default 0.05)} bends the open envelope's shapes from where they were when it opened → {points, shapes}. One undo step",
   :source "crates/engine/src/cmds_envelope.rs"}
  {:id "modify.flip_h",
   :label "Flip Horizontal",
   :params "{}",
   :source "crates/engine/src/cmds_modify.rs"}
  {:id "modify.flip_v",
   :label "Flip Vertical",
   :params "{}",
   :source "crates/engine/src/cmds_modify.rs"}
  {:id "modify.group",
   :label "Group",
   :params
   "{} puts the selected elements on each layer into one group there (ADR 0073), where the topmost of them was, and selects it → {group, members} (one layer) or {layers: [..]}. Members keep their places exactly: the group's transform starts as the identity. Raw shapes inside merge only with each other; double-click the group (symbol.edit) to edit it in place",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "modify.intersect",
   :label "Intersect",
   :params "{} combine with op intersect",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "modify.punch",
   :label "Punch",
   :params "{} combine with op punch",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "modify.remove_transform",
   :label "Remove Transform",
   :params "{}",
   :source "crates/engine/src/cmds_modify.rs"}
  {:id "modify.rotate_ccw",
   :label "Rotate 90° CCW",
   :params "{}",
   :source "crates/engine/src/cmds_modify.rs"}
  {:id "modify.rotate_cw",
   :label "Rotate 90° CW",
   :params "{}",
   :source "crates/engine/src/cmds_modify.rs"}
  {:id "modify.transform",
   :label "Transform",
   :params
   "{a, b, c, d, e, f} affine applied in stage space (free transform), to the selection on every layer",
   :source "crates/engine/src/cmds_modify.rs"}
  {:id "modify.ungroup",
   :label "Ungroup",
   :params
   "{} puts each selected group's members back on its layer where it was, each placed and coloured as the group showed it, and selects them; raw shapes among them merge with the drawing there → {members}",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "modify.union",
   :label "Union",
   :params "{} combine with op union",
   :source "crates/engine/src/cmds_group.rs"}
  {:id "motion.add_point",
   :label "Add Motion Path Point",
   :params
   "{x, y, slop? (stage units, default 4) | segment, t (0..1), layer?, frame?}: an anchor on the motion path, its shape unchanged → {anchor}",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.clear_path",
   :label "Remove Motion Path",
   :params
   "{layer?, frame?}: back to the straight path the X/Y curves trace",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.convert_point",
   :label "Convert Motion Path Point",
   :params
   "{anchor, smooth: bool, layer?, frame?}: smooth (handles in line) or corner (handles on the anchor)",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.delete_points",
   :label "Delete Motion Path Points",
   :params
   "{anchors: [index, ..] (as motion.info lists them; the ends stay), layer?, frame?}: the path refits through the rest",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.info",
   :label "Motion Tween",
   :params
   "{layer?, frame?} → the span's properties, keys, eases and values at the frame, its motion path, its anchors pinned to frames (pins) and where the object is",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.join",
   :label "Join Motion",
   :params
   "{layer?, frame?, to? (the last frame of the spans to join; default: the span after the one at the frame)}: adjacent motion tweens of one object become one, keeping every frame as it was → {start, frames, joined}",
   :source "crates/engine/src/cmds_retime.rs"}
  {:id "motion.move_keys",
   :label "Move Property Keyframes",
   :params
   "{keys: [{property, frame}, ..] (frames as motion.info lists them), by (frames; negative = earlier), layer?, frame? (in the span; default: the first key's)}: values and eases travel with their keys; no key moves outside the span or onto or past a key of its property that isn't moving (the move stops there); a pinned path point's X and Y keys move together → {by, keys}",
   :source "crates/engine/src/cmds_retime.rs"}
  {:id "motion.move_path",
   :label "Move Motion Path",
   :params
   "{dx, dy, layer?, frame?}: the whole path with its object, keeping the timing",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.orient",
   :label "Orient to Path",
   :params
   "{orient: bool, layer?, frame?}: turn the object as its motion path turns",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.pin_point",
   :label "Pin Motion Path Point",
   :params
   "{anchor? (default: a new anchor where the object is), frame? (the frame to pin it to, between the first and last position keys), layer?}: the object passes the anchor exactly on that frame → {anchor, frame, pins}",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.remove_key",
   :label "Remove Property Keyframe",
   :params "{property? (default: every property), frame?, layer?}",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.set_ease",
   :label "Property Ease",
   :params
   "{easing (as timeline.set_easing takes it, saved eases too), property? (default: every property), frame? (inside the segment), layer?}",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.set_key",
   :label "Property Keyframe",
   :params
   "{property: x|y|scale_x|scale_y|rotation|skew|alpha|brightness|tint (amount)|tint_red|tint_green|tint_blue (0..255)|red_multiplier|green_multiplier|blue_multiplier|alpha_multiplier (%)|red_offset|green_offset|blue_offset|alpha_offset (-255..255)|filter.<slot>.<blur_x|blur_y|strength (%)|angle|distance|brightness|contrast|saturation|hue> (a number of the object's filter at that place, 0 the first; ADR 0092), value (px, %, °), frame?, layer?} (colour properties of several styles compose into Advanced, ADR 0056)",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.set_path",
   :label "Edit Motion Path",
   :params
   "{d: SVG path data in stage space (its first subpath; ends are the start and end positions), layer?, frame?}",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "motion.split",
   :label "Split Motion",
   :params
   "{layer?, frame?}: the motion tween becomes two at the frame, each moving as before → {first, second}",
   :source "crates/engine/src/cmds_retime.rs"}
  {:id "motion.unpin_point",
   :label "Unpin Motion Path Point",
   :params
   "{anchor? | frame?, layer?}: the anchor shapes the path only again; the X/Y keys of its frame go → {anchor, frame, pins}",
   :source "crates/engine/src/cmds_motion.rs"}
  {:id "paint.apply_style",
   :label "Apply Style",
   :params
   "{fill?: bool, stroke?: bool} (default both) gives the selected shapes the fill swatch's paint (shapes with a fill) and the stroke settings (shapes with a line, and drawing objects without one)",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "paint.bucket",
   :label "Paint Bucket",
   :params
   "{x, y, color?, gap? (stage units: how wide an opening still counts as closed), object?: bool} fills the closed area under the point, or recolours the fill there; unless `object` (default: the Object Drawing setting), the fill is raw and merges with the drawing (an area closed by raw lines and fills is filled exactly up to them)",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "paint.ink",
   :label "Ink Bottle",
   :params
   "{x, y, color?, width?, profile?, cap?, join?, miter?, style?, dash?, dash_offset?, dot_spacing?} (the tool's line style unless given; see stroke.set_style)",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "paint.lock_fill",
   :label "Lock Fill",
   :params
   "{on?: bool (default: toggle)} Lock Fill: a gradient or bitmap from the fill swatch is poured where it lies on the stage, running on across shapes; off, each shape gets it fitted to its bounds → {on}",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "paint.pick",
   :label "Eyedropper",
   :params
   "{x, y, other?: bool (into the other swatch only: a fill's colour into the stroke, a line's into the fill), slop?} picks the style under the point on any visible layer into the tool settings: a fill's paint (solid, gradient or bitmap, kept where it is on the stage) into the fill swatch, a line's colour, width and profile into the stroke settings",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "paint.set_fill",
   :label "Fill",
   :params
   "{type?: solid|linear|radial|bitmap (default: the swatch's), color? (solid), stops?: [{offset: 0..1, color: \"#rrggbb\" | \"#rrggbbaa\"}, ..] (2 to 15), spread?: extend|reflect|repeat, linear_rgb?: bool, focal?: -0.98..0.98 (radial), bitmap?: id, selection?: bool (default true)} sets the fill swatch (what new shapes, the Paint Bucket and the Brush pour) and, unless `selection` is false, the fills of the selected shapes. A shape keeping its kind of fill keeps where its gradient or bitmap lies; one changing kind gets it fitted to its bounds. A new gradient starts white to black → {fill: {type, ..}, changed}",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "paint.transform_fill",
   :label "Gradient Transform",
   :params
   "{element?: id (default: the selected shapes with a gradient or bitmap fill), frame?: [a, b, c, d, e, f] (the fill's frame in the space being edited: the box -1..1 onto a linear gradient's span, a radial gradient's ring or one copy of a bitmap), or changes made in this order: scale_x?, scale_y?, scale? (along the frame's own axes), skew_x?, skew_y? (degrees, along its axes), rotate? (degrees, about its centre), move?: [dx, dy], center?: [x, y]; focal?: -0.98..0.98 (radial)} moves, turns, scales or skews where a gradient or bitmap fill lies, as the Gradient Transform tool (F) does → {changed, frames: [[a, b, c, d, e, f], ..]}",
   :source "crates/engine/src/cmds_paint.rs"}
  {:id "path.add_point",
   :label "Add Anchor Point",
   :params "{id, x, y, slop?}",
   :source "crates/engine/src/cmds_path.rs"}
  {:id "path.bend_segment",
   :label "Bend Segment",
   :params
   "{x, y, dx, dy, id?, cmd?, t?, slop?, merge?: bool} the segment at (x, y) (of shape `id`, else the one there) bends so that point moves by (dx, dy), its ends staying; a raw shape's copies of the edge bend with it and merge again (unless merge is false)",
   :source "crates/engine/src/cmds_raw.rs"}
  {:id "path.convert_point",
