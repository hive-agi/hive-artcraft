 [{:name "session_inspect",
   :description
   "\"The whole session as JSON: project, mesh, texture sets (resolution, channels, baked maps), the layer stack \\\n        top to bottom (fill sources, masks, effects, painted tile counts), tool, camera, display and history.\"",
   :source "crates/automation/src/server.rs"}
  {:name "command_list",
   :description
   "List engine commands: id, label, menu path, shortcut, params doc and whether it can run now.",
   :source "crates/automation/src/server.rs"}
  {:name "command_run",
   :description
   "\"Run an engine command by id with JSON params (see command_list). Runs with defaults, never opens a \\\n        dialog. Commands given host paths (file.open, file.save, resource.import, material.save, …) are disabled: use the \\\n        workspace tools (project_open, project_save, mesh_import, mesh_reimport, mesh_export, bake_mesh_add, resource_import, \\\n        material_save, material_load, textures_export).\"",
   :source "crates/automation/src/server.rs"}
  {:name "command_batch",
   :description
   "\"Run several commands in order: steps [{id, params}]. Stops at the first error. Returns {completed, \\\n        results, failed: {index, id, error} | null}; a failed batch is a tool error.\"",
   :source "crates/automation/src/server.rs"}
  {:name "project_new",
   :description
   "\"Start a new project on a built-in mesh (one texture set per material, each with an empty paint layer). \\\n        Returns the session.\"",
   :source "crates/automation/src/server.rs"}
  {:name "project_open",
   :description
   "Open a .tcraft project or a mesh file (path relative to the read root). Returns the session.",
   :source "crates/automation/src/server.rs"}
  {:name "project_save",
   :description
   "Save the project as .tcraft (path relative to the write root; omit to save to its own file).",
   :source "crates/automation/src/server.rs"}
  {:name "mesh_import",
   :description
   "\"New project from a mesh file (path relative to the read root): one texture set per material. Returns \\\n        the session; import warnings are in the session log.\"",
   :source "crates/automation/src/server.rs"}
  {:name "mesh_reimport",
   :description
   "\"Reimport the project's mesh from a file (path relative to the read root) or, without a path, from \\\n        the project's own copy. Texture sets map by material index; `preserveStrokes` re-projects painted pixels where the UVs \\\n        changed. Returns {preserved?}.\"",
   :source "crates/automation/src/server.rs"}
  {:name "mesh_export",
   :description
   "\"Export the mesh with its textures (obj, glb, usda, usdc or usdz; path relative to the write root). \\\n        Returns {path, textures?}.\"",
   :source "crates/automation/src/server.rs"}
  {:name "bake_mesh_add",
   :description
   "\"Add a high-definition mesh for baking (path relative to the read root), or with `cage: true` set the \\\n        bake cage. Files next to a .gltf or USD layer (buffers, base color textures) come along. Returns {name, meshes}; bake \\\n        with `bake`.\"",
   :source "crates/automation/src/server.rs"}
  {:name "resource_import",
   :description
   "\"Import an image (png, jpg, tga, tif, bmp, webp, exr, hdr; path relative to the read root) as a project \\\n        resource. Returns its name, for command_run layer.add.image {name} or tool.stencil {image}.\"",
   :source "crates/automation/src/server.rs"}
  {:name "material_save",
   :description
   "Save a layer or folder (default: the selected one) as a smart material file (.tcmat) below the write root.",
   :source "crates/automation/src/server.rs"}
  {:name "material_load",
   :description
   "Add a smart material from a .tcmat file (relative to the read root) above the selection. Returns its layer.",
   :source "crates/automation/src/server.rs"}
  {:name "textures_export",
   :description
   "\"Export textures with a preset into a folder relative to the write root. Returns the written files and \\\n        warnings.\"",
   :source "crates/automation/src/server.rs"}
  {:name "bake",
   :description
   "\"Bake mesh maps (ambient occlusion, curvature, thickness, …) for generators and smart materials. Rays run \\\n        on the GPU when there is one (`cpu: true` forces the CPU); per-map ray settings are `bake.settings` parameters (command_run).\"",
   :source "crates/automation/src/server.rs"}
  {:name "paint_stroke",
   :description
   "\"Paint a stroke with the paint tool on the selected layer (or its mask target): sets the brush material \\\n        (color, roughness, metallic, height) and size/hardness, then strokes through `points` in viewport pixels. See \\\n        viewport_render for where the mesh is.\"",
   :source "crates/automation/src/server.rs"}
