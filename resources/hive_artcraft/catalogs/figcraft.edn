 [{:name "list_commands",
   :title "List commands",
   :description
   "List FigCraft commands: id, label, menu path, shortcut, whether it is undoable, and a parameter description. Every menu item, panel action and shortcut is a command; run one with run_command (or several as one undo step with batch). Most commands act on `ids` when given, else on the selection. Use `filter` to narrow (e.g. \"align\", \"layout\", \"variable\", \"style\", \"component\", \"proto\").",
   :input-schema-source
   "obj(json!({\"filter\": string(\"Case-insensitive substring matched against id, label, menu path and parameter docs\")}), &[])",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}
  {:name "run_command",
   :title "Run command",
   :description
   "Execute one FigCraft command by id with JSON params (ids and params from list_commands). Mutating commands are one undo step each; a failing command leaves the document unchanged. Examples: {\"command\":\"align.left\",\"params\":{\"ids\":[3,4]}}, {\"command\":\"layout.add\",\"params\":{\"ids\":[2],\"direction\":\"vertical\"}}, {\"command\":\"style.create\",\"params\":{\"type\":\"paint\",\"name\":\"Brand/Primary\",\"from\":5}}. Returns the command's result (creation commands return {\"id\"}). Programmatic calls never open dialogs.",
   :input-schema-source
   "obj(\n                json!({\"command\": string(\"Command id, e.g. node.create, align.left, component.create, file.export\"), \"params\": {\"type\": \"object\", \"description\": \"Command parameters (see list_commands)\"}}),\n                &[\"command\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "batch",
   :title "Run commands as one step",
   :description
   "Run several commands in order as ONE undo step (engine `command.batch`). By default (onError: \"abort\"), if any command fails, everything is rolled back and the error names the failing step; success returns an array of the results in order. With onError: \"continue\", a failed step is rolled back on its own, the later steps still run, the call is not an error, and the array instead holds one {step, command, ok, result} or {step, command, ok, error} object per step; a reference to a failed step fails that step too. A later step can use what an earlier step returned: name a step with \"as\": \"card\", then anywhere in a later step's params {\"$ref\": \"card\"} stands for the `id` in its result ({\"$step\": n} does the same by zero-based position). Add \"field\" for another part of the result: a key or a slash path, e.g. {\"$ref\": \"copy\", \"field\": \"ids/0\"} for the first id edit.duplicate returned (with \"map\": true it also returns `map`, each original id → its copy, so \"field\": \"map/3\" is the copy of layer 3). Any object with a `$ref` or `$step` key is a reference. Example: [{\"command\":\"node.create\",\"as\":\"card\",\"params\":{\"type\":\"frame\"}}, {\"command\":\"node.create\",\"params\":{\"type\":\"text\",\"text\":\"Hi\",\"parent\":{\"$ref\":\"card\"}}}] builds a frame and a text inside it in one call.",
   :input-schema-source
   "obj(\n                json!({\n                    \"commands\": {\"type\": \"array\", \"minItems\": 1, \"description\": \"Steps to run\", \"items\": obj(json!({\"command\": string(\"Command id\"), \"params\": {\"type\": \"object\"}, \"as\": string(\"Name for this step, unique in the batch; later steps use its result with {\\\"$ref\\\": name}\")}), &[\"command\"])},\n                    \"label\": string(\"Undo history label (default \\\"Batch\\\")\"),\n                    \"onError\": {\"type\": \"string\", \"enum\": [\"abort\", \"continue\"], \"description\": \"abort (default) rolls back the whole batch on the first failure; continue rolls back only the failed step, runs the rest and returns one {step, command, ok, result|error} object per step\"},\n                }),\n                &[\"commands\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "create_node",
   :title "Create layer",
   :description
   "Create a layer (engine `node.create`) and return its id and inspected properties. Coordinates are page units, y down; x/y are relative to the parent frame (the page when there is none, so then they are page coordinates; groups don't count). Inside an auto-layout frame the position is decided by the layout. The new layer becomes the selection.",
   :input-schema-source
   "obj(\n                json!({\n                    \"type\": {\"type\": \"string\", \"enum\": [\"frame\", \"rectangle\", \"ellipse\", \"polygon\", \"star\", \"line\", \"arrow\", \"text\", \"vector\", \"section\", \"component\", \"slice\"], \"description\": \"Layer type\"},\n                    \"x\": num(\"Left, relative to the parent frame (default 0). For a vector with `path` or `points`, x/y move their own origin instead: data whose box starts at (30, 0) makes a layer whose left is x + 30. Start the path at 0,0 to place its left edge at x, or set x afterwards with set_properties (which moves the left edge)\"),\n                    \"y\": num(\"Top, relative to the parent frame (default 0). For a vector with `path` or `points`, their own top is added, as for x\"),\n                    \"width\": num(\"Width (default 100; text hugs its content unless width is set, which makes it wrap; for a vector with path, width/height scale the path, one alone keeping its proportion, and without them the path's own box is used)\"),\n                    \"height\": num(\"Height (default 100; ignored for lines/arrows and auto-height text)\"),\n                    \"parent\": id_schema(\"Parent frame/group/component id (default: the current page)\"),\n                    \"index\": int(\"Z-index among the parent's children (default: on top)\"),\n                    \"name\": string(\"Layer name\"),\n                    \"text\": string(\"Characters, for type text\"),\n                    \"path\": string(\"SVG path data, for type vector (e.g. \\\"M0 0 L100 0 L50 80 Z\\\"); its coordinates are kept relative to x/y, so a path that doesn't start at 0,0 is offset by its own box\"),\n                    \"points\": {\"type\": \"array\", \"items\": {\"type\": \"array\", \"items\": {\"type\": \"number\"}}, \"description\": \"For type vector, instead of path: the points [[x, y], ...]\"},\n                    \"closed\": boolean(\"For type vector: close the path\"),\n                    \"select\": boolean(\"Select the new layer (default true)\"),\n                    \"props\": {\"type\": \"object\", \"description\": \"Any set_properties keys applied at creation, e.g. {\\\"fill\\\":\\\"#3366FF\\\",\\\"cornerRadius\\\":12,\\\"fontSize\\\":24,\\\"layout\\\":\\\"vertical\\\",\\\"gap\\\":8,\\\"padding\\\":16}\"},\n                }),\n                &[\"type\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "set_properties",
   :title "Set properties",
   :description
   "Set properties on one or more layers as one undo step (engine `node.set`). Keys: name, visible, locked, opacity (0-1), blend, x, y (relative to the parent frame; groups don't count), width, height, rotation (degrees), absoluteRotation (degrees on the page), fill (colour) / fills (array of paints: \"#hex\" or {\"type\":\"solid\",\"color\":\"#hex\"} or {\"type\":\"linearGradient\",\"stops\":[\"#hex\",\"#hex\"]} or stops [{\"position\":0..1,\"color\":\"#hex\"}], optional from/to handles in the unit box; radialGradient too), stroke / strokes, strokeWeight, strokeAlign (inside|center|outside), cornerRadius (n or [tl,tr,br,bl]), effects (array, e.g. {\"type\":\"dropShadow\",\"color\":\"#00000040\",\"offset\":[0,4],\"radius\":8}), clip, layout (null|horizontal|vertical|grid), gap, padding (n or [t,r,b,l]), mainAlign (min|center|max|spaceBetween|spaceAround|spaceEvenly), crossAlign, wrap, contentAlign (auto|spaceBetween: wrapped lines), sizingH / sizingV (fixed|hug|fill), constraints {horizontal, vertical}, characters, fontFamily, fontStyle, fontSize, lineHeight, letterSpacing, textAlign, textAutoResize. Auto layout keys (gap, padding, mainAlign, crossAlign, wrap, …) apply to frames, components and instances only: other layers among the ids are skipped and named in `warnings`, and with none that can take them the call is an error. A fontStyle draws in the family's nearest face; `warnings` says when that face has another weight or slant than the name asks for. Run list_commands with filter \"node.set\" for the full list. Unknown keys are an error. Returns the updated layers.",
   :input-schema-source
   "obj(\n                json!({\"ids\": ids_schema(\"Layer ids (default: the selection)\"), \"props\": {\"type\": \"object\", \"description\": \"Property values to set\"}}),\n                &[\"props\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_document",
   :title "Inspect document",
   :description
   "The active document as JSON: name, path, dirty flag, current page, selection, the current page's layer tree (id, name, type, x/y relative to the parent frame (groups don't count), width, height, absoluteBounds in page coordinates, fills, strokes, effects, cornerRadius, layout, sizing, text properties, component links, overrides, bound variables), other pages summarised, styles, variable count and the undo history. Use it to verify every change. Each level of `depth` multiplies the response, and `allPages` multiplies it again: on a large document the tree is reported at a shallower depth than asked for, with a `truncated` object saying so. Use get_node to read one subtree deeply instead.",
   :input-schema-source
   "obj(\n                json!({\n                    \"depth\": int(\"Tree depth for the current page (default 4)\"),\n                    \"fields\": fields_schema(),\n                    \"outline\": outline_schema(),\n                    \"allPages\": boolean(\"Expand every page, not only the current one\"),\n                    \"maxBytes\": int(\n                        \"Largest response to send, in bytes of the whole JSON-RPC message (default 8388608, which fits the usual 10 MiB client buffer); 1024 of it is kept for the envelope and the request id\"\n                    ),\n                }),\n                &[],\n            )",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}
  {:name "get_node",
   :title "Get layer",
   :description
   "One layer as JSON (same fields as inspect_document) with its children to `depth`. A subtree too large for one message is reported at a shallower depth, or with a window of the children, and a `truncated` object says so and gives the `offset` to ask for next.",
   :input-schema-source
   "obj(\n                json!({\n                    \"id\": id_schema(\"Layer id\"),\n                    \"depth\": int(\"Child depth (default 1)\"),\n                    \"fields\": fields_schema(),\n                    \"outline\": outline_schema(),\n                    \"offset\": int(\"First child to report (default 0), for reading a node with more children than fit in one message\"),\n                    \"maxBytes\": int(\n                        \"Largest response to send, in bytes of the whole JSON-RPC message (default 8388608, which fits the usual 10 MiB client buffer); 1024 of it is kept for the envelope and the request id\"\n                    ),\n                }),\n                &[\"id\"],\n            )",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}
  {:name "select",
   :title "Select layers",
   :description
   "Replace the selection with `ids` (switching to their page). An empty array deselects everything. Most commands act on the selection when no `ids` are passed.",
   :input-schema-source
   "obj(json!({\"ids\": ids_schema(\"Layer ids to select\")}), &[\"ids\"])",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "export",
   :title "Export",
   :description
   "Export layers (default: the selection, else every top-level layer of the current page) as png, jpg, svg, webp, pdf or xml (an Android Vector Drawable, with `warnings` for what it changed or left out, per `vdCompat`) at `scale`, or the whole file as `fig` (experimental: written from public format knowledge, with `warnings` for what was left out; other apps may not open every file) (PDF: with `bleed`, `cropMarks`, `bleedMarks` and `cmyk` for print; options `contentsOnly`, `includeBoundingBox`, and for SVG `svgOutlineText`, `svgIdAttribute`, `svgSimplifyStroke`; for XML `svgIdAttribute` and `vdCompat`; for png, jpg and webp `colorProfile`). With `path` the file is written there (absolute path recommended) and the result says where. Without `path`: png/jpg/webp come back as an image content block, svg as text, xml as text followed by `{format, warnings}`, other formats as base64 `data`.",
   :input-schema-source
   "obj(\n                json!({\n                    \"ids\": ids_schema(\"Layers to export (several are composited into one image)\"),\n                    \"format\": {\"type\": \"string\", \"enum\": [\"png\", \"jpg\", \"svg\", \"webp\", \"pdf\", \"xml\", \"fig\"], \"description\": \"Format (default png, or from the path's extension)\"},\n                    \"scale\": num(\"Pixel scale for raster formats (default 1, max 64)\"),\n                    \"size\": string(\"Instead of `scale`: `2x`, or a width or height in pixels like `512w` / `512h`\"),\n                    \"path\": string(\"Output file path\"),\n                    \"bleed\": {\"type\": [\"number\", \"string\"], \"description\": \"PDF: bleed around each page, in points or as a length like `3mm` or `0.125in`\"},\n                    \"cropMarks\": boolean(\"PDF: crop marks\"),\n                    \"bleedMarks\": boolean(\"PDF: bleed marks\"),\n                    \"cmyk\": boolean(\"PDF: CMYK colour instead of RGB\"),\n                    \"contentsOnly\": boolean(\"Only the layers themselves (default true); false also draws every other layer that shows in their area\"),\n                    \"includeBoundingBox\": boolean(\"Export the layers' own boxes, cutting off shadows and outside strokes (default false)\"),\n                    \"svgOutlineText\": boolean(\"SVG: text as outlines (default true); false keeps `<text>` elements\"),\n                    \"svgIdAttribute\": boolean(\"SVG: layer names as unique `id` attributes (default false)\"),\n                    \"svgSimplifyStroke\": boolean(\"SVG: strokes as `stroke` attributes where exact (default true); false writes outlines\"),\n                    \"vdCompat\": {\"type\": \"string\", \"enum\": [\"bestEffort\", \"exact\", \"ignore\"], \"description\": \"XML: what a Vector Drawable can't draw exactly is approximated with a warning (bestEffort, default), left out with a warning (exact), or written as far as it maps without warnings (ignore: overlapping layer opacity dropped, even-odd fills kept as fillType=evenOdd, diamond gradients left out)\"},\n                    \"colorProfile\": {\"type\": \"string\", \"enum\": [\"sameAsFile\", \"srgb\", \"displayP3\"], \"description\": \"PNG, JPG and WebP: the color profile of the file (default sameAsFile: the document's); colors are converted and out-of-gamut ones clip. SVG, XML and RGB PDF output are always sRGB; PDF with cmyk is DeviceCMYK\"},\n                    \"quality\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 100, \"description\": \"JPG: the encoder's quality, 1 (smallest file) to 100; default 90\"},\n                }),\n                &[],\n            )",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}
  {:name "screenshot",
   :title "Screenshot",
   :description
   "Look at the design: renders the given layers (or the whole current page, with its background) to PNG and returns it as image content, plus its size and the scale used. The image is scaled down to fit `maxSize` pixels. With `window: true` (or a window id from `inspect_ui`'s `windows`) and an attached app, captures that app window including the UI instead.",
   :input-schema-source
   "obj(\n                json!({\n                    \"ids\": ids_schema(\"Layers to render (default: the whole current page)\"),\n                    \"scale\": num(\"Requested scale (default 1; reduced to fit maxSize)\"),\n                    \"maxSize\": int(\"Largest side in pixels (default 1600)\"),\n                    \"window\": {\"description\": \"Capture the app window: true for the one in front, or a window id (attached app only; headless renders the page)\", \"anyOf\": [{\"type\": \"boolean\"}, {\"type\": \"integer\"}]},\n                }),\n                &[],\n            )",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}
  {:name "open_file",
   :title "Open file",
   :description
   "Open a .figcraft or .json document (FigCraft or REST API file JSON), a .fig or .sketch file (best effort, with `warnings` for what wasn't imported; .sketch from Sketch 48 or newer), an .svg (becomes vectors) or an image (becomes an image layer) as the active document. Returns the new document's summary.",
   :input-schema-source
   "obj(\n                json!({\n                    \"path\": string(\"File path\"),\n                    \"variables\": {\"description\": \"REST API file JSON only: the local variables JSON (`GET /v1/files/:key/variables/local`) as a path or the JSON object. Default: `<name>.variables.json` or `variables.json` next to the file.\"},\n                    \"reload\": boolean(\"A file that is already open: read it again from disk into its tab (refused while the tab has unsaved changes). Without it, the result says `stale: true` when the file changed on disk since the tab read or saved it\"),\n                }),\n                &[\"path\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "save_file",
   :title "Save file",
   :description
   "Save the active document as a .figcraft file. `path` is required the first time (an untitled document has no path); later saves reuse it. A `path` ending in .fig writes an experimental .fig export copy instead and leaves the document's own path and unsaved changes alone.",
   :input-schema-source
   "obj(json!({\"path\": string(\"Output .figcraft path, or a .fig path for an experimental export copy\")}), &[])",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "undo",
   :title "Undo",
   :description
   "Undo the last change (one command, batch or gesture). Returns {undone: bool}.",
   :input-schema-source "empty()",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "redo",
   :title "Redo",
   :description "Redo the last undone change. Returns {redone: bool}.",
   :input-schema-source "empty()",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "pointer",
   :title "Pointer gesture",
   :description
   "Drive the canvas with the mouse in page coordinates, exactly as a user would with the current tool: click to select, drag to move/resize/marquee, or draw with a shape tool (set `tool` first, e.g. {\"tool\":\"rectangle\",\"kind\":\"drag\",\"x\":0,\"y\":0,\"to\":[200,100]}). `double` on a text layer starts editing it. Returns the selection and tool.",
   :input-schema-source
   "obj(\n                json!({\n                    \"kind\": {\"type\": \"string\", \"enum\": [\"click\", \"double\", \"drag\", \"down\", \"move\", \"up\", \"hover\"], \"description\": \"Gesture (default click)\"},\n                    \"x\": num(\"Page x\"),\n                    \"y\": num(\"Page y\"),\n                    \"to\": {\"type\": \"array\", \"items\": {\"type\": \"number\"}, \"minItems\": 2, \"maxItems\": 2, \"description\": \"Drag end [x, y] (page)\"},\n                    \"steps\": int(\"Intermediate move events for drag (default 8)\"),\n                    \"tool\": {\"type\": \"string\", \"description\": \"Tool to choose first: move|scale|hand|frame|section|slice|rectangle|line|arrow|ellipse|polygon|star|pen|pencil|text|comment|annotation\"},\n                    \"shift\": boolean(\"Shift held\"),\n                    \"alt\": boolean(\"Alt/Option held\"),\n                    \"cmd\": boolean(\"Cmd (macOS) / Ctrl held\"),\n                    \"ctrl\": boolean(\"Ctrl held (the Control key on macOS)\"),\n                    \"pressure\": num(\"Pen pressure 0-1 (the Pencil records it as the stroke's width profile; a drag starts with it)\"),\n                    \"pressureTo\": num(\"Pen pressure 0-1 at a drag's end (interpolated along it)\"),\n                }),\n                &[\"x\", \"y\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "key",
   :title "Press key",
   :description
   "Press a key or shortcut as if typed on the canvas: a menu shortcut (e.g. {\"key\":\"G\",\"cmd\":true} groups, {\"key\":\"A\",\"alt\":true,\"shift\":false} …), a tool key (R, O, T, F, V…), Escape, Delete, Enter, arrows (nudge; shift = big nudge). While editing text, keys go to the text editor (Backspace, Delete, Left, Right, Home, End, Enter, Escape, SelectAll).",
   :input-schema-source
   "obj(\n                json!({\"key\": string(\"Key name: a letter/digit, Escape, Delete, Backspace, Enter, ArrowLeft…\"), \"shift\": boolean(\"Shift\"), \"alt\": boolean(\"Alt/Option\"), \"cmd\": boolean(\"Cmd/Ctrl\"), \"ctrl\": boolean(\"Ctrl (the Control key on macOS)\")}),\n                &[\"key\"],\n            )",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "type_text",
   :title "Type text",
   :description
   "Type into a text layer. With `id`, starts editing that layer with all of its text selected (so the typed text replaces it), types, then stops editing. Without `id`, types at the caret of the text currently being edited (after a double-click with pointer, or after drawing with the text tool).",
   :input-schema-source
   "obj(json!({\"text\": string(\"Text to type (\\\\n for a new line)\"), \"id\": id_schema(\"Text layer to replace the contents of\")}), &[\"text\"])",
   :read-only false,
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_ui",
   :title "Inspect UI",
   :description
   "UI state: current tool, view (zoom, centre), status, panels, timings and the app's windows (`windows`: id, title, files) when attached to the app; headless reports the session status.",
   :input-schema-source "empty()",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}
  {:name "wait_for_changes",
   :title "Wait for changes",
   :description
   "Wait for new comment events in the attached FigCraft app. Returns pending events immediately; otherwise waits up to `timeoutMs` (default 20000, max 25000). Call it again with the returned `cursor` to keep watching. Headless returns immediately (no other writer). Events carry a sequence number, kind, document and a small payload (for comments, the thread id).",
   :input-schema-source
   "obj(\n                json!({\n                    \"after\": int(\"Return events after this cursor (default 0)\"),\n                    \"timeoutMs\": int(\"Longest wait in milliseconds (default 20000, max 25000)\"),\n                    \"topics\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"comments\", \"document\", \"all\"]}, \"description\": \"Event topics (default [\\\"comments\\\"]; document events are not emitted yet)\"},\n                    \"limit\": int(\"Most events to return (default 100, max 1000)\")\n                }),\n                &[],\n            )",
   :read-only true,
   :source "crates/mcp/src/tools.rs"}],
 :control
 ["app.quit"
  "document.inspect"
  "engine.commands"
  "engine.execute"
  "events.poll"
  "node.get"
  "ui.input"
  "ui.inspect"
  "ui.key"
  "ui.menu.invoke"
  "ui.pointer"
  "ui.render"
  "ui.screenshot"
  "ui.set"
  "ui.type"
  "window.focus"
  "window.list"
  "window.new"]}
