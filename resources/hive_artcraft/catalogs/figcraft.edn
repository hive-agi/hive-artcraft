  {:id "branch.archive",
   :label "Archive branch",
   :params
   "{id?}  set the branch aside without merging (it stays in the file and can still be opened) and close its tab",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "branch.create",
   :label "Create branch",
   :params
   "{name?}  a copy of the file to work on separately, opened in a new tab; it remembers the file as it is now (its base); in a live session it stays yours → {id, name, index (its tab)}",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "branch.list",
   :label "List branches",
   :params
   "{}  the branches of the file shown (or of the file a branch tab belongs to), oldest first → [{id, name, time (Unix seconds), state: active|merged|archived, index? (its open tab)}]",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "branch.merge",
   :label "Merge branch",
   :params
   "{id?, resolutions? ({<conflict key>: \"branch\" | \"main\"})}  merge the branch into the main file as one undo step (in a live session one edit everyone gets; refused on a view link), then archive it and show the main file; refused while a conflict has no resolution → {merged, changes, conflicts, index}",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "branch.open",
   :label "Open branch",
   :params
   "{id}  open the branch in a tab (or switch to its tab) → {index}",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "branch.review",
   :label "Review branch",
   :params
   "{id? (default: the branch tab shown)}  what changed on the branch and on the main file since the branch was made or last updated from main, and where they conflict (the same property changed on both sides, or a layer deleted on one side and edited on the other) → {id, name, state, branch: {layers, document, truncated}, main: {…}, conflicts: [{key, id?, name, property, branch, main, deletedBy?}]}",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "branch.updateFromMain",
   :label "Update from main",
   :params
   "{id?, resolutions? ({<conflict key>: \"branch\" | \"main\"})}  bring the main file's changes since the branch was made into the branch (a version in its history); refused while a conflict has no resolution. Not undoable (the branch tab's undo history starts over) → {updated, changes, conflicts}",
   :source "crates/engine/src/sharing/branches.rs"}
  {:id "codeConnect.export",
   :label "Export code connections",
   :params
   "{path? (write it there, e.g. figcraft.connect.json in the code repository)}  every component's links as {version: 1, links: [{component (its name), language, importPath, name, template}]}, sorted  → {text, links} or {path, links}",
   :source "crates/engine/src/dev/code_connect.rs"}
  {:id "codeConnect.import",
   :label "Import code connections",
   :params
   "{json (the connect JSON as codeConnect.export writes it: an object or JSON text) | path (a figcraft.connect.json)}  links each entry to every component or set of that name (replacing its link for the language); invalid entries and unknown components are skipped with a warning  → {linked, warnings}",
   :source "crates/engine/src/dev/code_connect.rs"}
  {:id "codeConnect.remove",
   :label "Disconnect from code",
   :params
   "{id? (component, set or instance; default the selection), language? (omit: every language)}  → {component, removed}",
   :source "crates/engine/src/dev/code_connect.rs"}
  {:id "codeConnect.set",
   :label "Connect to code",
   :params
   "{id? (component, set or instance; default the selection), language?: react|leptos|vue|swiftui|compose|arkui|flutter (default react), importPath?, name? (default the generated name), template? (default a call passing every property)}  links the component (its set, for a variant) to its code component; fields left out keep their current value. Placeholders: {property} (its name or parameter name) and {property ? \"a\" : \"b\"}; other {…} stay as written  → {component, language, code (the snippet for the layer), unknown (placeholder names that aren't properties)}",
   :source "crates/engine/src/dev/code_connect.rs"}
  {:id "collab.cursor",
   :label "Show cursor at",
   :params
   "{x?, y? (page coordinates on the current page; omit both to hide)} → {cursor} (agents; in the app the pointer drives it): your pointer in the open file's session (null when the file isn't in one)",
   :source "crates/engine/src/sharing/live/join.rs"}
  {:id "collab.cursorChat",
   :label "Cursor chat",
   :params
