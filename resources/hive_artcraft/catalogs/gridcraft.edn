 [{:name "execute_command",
   :title "Execute command",
   :description
   "\"Run ANY GridCraft command by id with JSON params — every ribbon/menu action is a command. Find ids and parameter \\\n             docs with list_commands. Examples: {\\\"command\\\":\\\"cell.set\\\",\\\"params\\\":{\\\"cell\\\":\\\"B2\\\",\\\"input\\\":\\\"=SUM(A1:A9)\\\"}}; \\\n             {\\\"command\\\":\\\"home.bold\\\",\\\"params\\\":{\\\"range\\\":\\\"A1:C1\\\"}}; {\\\"command\\\":\\\"sheet.insert\\\"}; \\\n             {\\\"command\\\":\\\"data.removeDuplicates\\\",\\\"params\\\":{\\\"range\\\":\\\"A1:C20\\\"}}. Most commands act on the current selection \\\n             when `range` is omitted. Programmatic calls never open dialogs: missing required params give an error.\"",
   :input-schema-source
   "obj(\n                json!({\"command\": string(\"Command id, e.g. \\\"cell.set\\\", \\\"home.fillColor\\\", \\\"insert.chart\\\"\"), \"params\": params_schema()}),\n                &[\"command\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "list_windows",
   :title "List windows",
   :description
   "\"List the open windows: window id, workbook (`doc`) id, title (\\\"Book1\\\", or \\\"Book1:2\\\" for a workbook's second \\\n             window), unsaved changes, active and hidden. Pass a `window` or `doc` id to other tools to act there.\"",
   :input-schema-source "empty()",
   :source "crates/mcp/src/tools.rs"}
  {:name "list_commands",
   :title "List commands",
   :description
   "\"List GridCraft commands: id, label, ribbon path, shortcut, a parameter description (`params`) and whether it can run \\\n             right now. Use it to discover what execute_command can do (e.g. search \\\"sort\\\", \\\"border\\\", \\\"chart\\\", \\\"sheet\\\").\"",
   :input-schema-source
   "obj(json!({\"search\": string(\"Case-insensitive substring matched against id, label and ribbon path\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "inspect_workbook",
   :title "Inspect workbook",
   :description
   "\"Summary of the active workbook: title, path, dirty flag, sheets (name, used range, cell count, tables, charts, merges, \\\n             filters, freeze panes), defined names, current selection and active cell, calculation mode and undo/redo history.\"",
   :input-schema-source "empty()",
   :source "crates/mcp/src/tools.rs"}
  {:name "read_range",
   :title "Read range",
   :description
   "\"Read cell values from a range as rows (2-D array). Numbers/booleans/strings are returned as JSON values, empty cells as \\\n             null, errors as {\\\"error\\\":\\\"#DIV/0!\\\"}. Without `range`, reads the sheet's used range. formulas:true returns formula \\\n             text (\\\"=SUM(B2:B4)\\\") for formula cells; formatted:true returns the displayed text (\\\"$1,234.00\\\", \\\"12%\\\").\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"range\": string(RANGE),\n                    \"sheet\": string(\"Sheet name (default: the active sheet)\"),\n                    \"formulas\": boolean(\"Return formulas instead of computed values for formula cells\"),\n                    \"formatted\": boolean(\"Return display text with number formats applied\"),\n                }),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "write_range",
   :title "Write range",
   :description
   "\"Write a 2-D array of values starting at the top-left cell of `range` (rows of cells). Numbers, booleans, null (clears) \\\n             and strings are accepted; strings starting with = are formulas (\\\"=SUM(B2:B4)\\\"), other strings are parsed like typed \\\n             input (\\\"12%\\\", \\\"1/2/2024\\\", \\\"$5\\\") unless `parse` is false, which stores them as the text they are. The result's \\\n             `converted` lists the strings that were read as something else. One undo step. Example: {\\\"range\\\":\\\"A1\\\",\\\"values\\\":[[\\\"Item\\\",\\\"Cost\\\"],[\\\"Rent\\\",1200]]}.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"range\": string(\"Top-left cell or range, e.g. \\\"A1\\\" or \\\"Sheet2!B3\\\"\"),\n                    \"values\": {\"type\": \"array\", \"description\": \"Rows of cell values\", \"items\": {\"type\": \"array\", \"items\": {\"type\": [\"string\", \"number\", \"boolean\", \"null\"]}}},\n                    \"parse\": boolean(\"Read strings not starting with = like typed input, so \\\"05.04.2026\\\" becomes a date (default true); false stores them as the text they are, and \\\"\\\" clears the cell\"),\n                }),\n                &[\"range\", \"values\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "set_cell",
   :title "Set cell",
   :description
   "\"Enter one cell exactly as if typed: a number, text, or a formula starting with = (\\\"=AVERAGE(B2:B9)\\\"). \\\n             Dependent cells recalculate. Returns the command result; use get_cell to read the computed value.\"",
   :input-schema-source
   "obj(\n                json!({\"cell\": string(\"Cell, e.g. \\\"B7\\\" or \\\"Sheet2!C3\\\"\"), \"input\": {\"type\": [\"string\", \"number\", \"boolean\"], \"description\": \"Typed input: number, text or =formula\"}}),\n                &[\"cell\", \"input\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "get_cell",
   :title "Get cell",
   :description
   "Details of one cell: computed value and type, formula, display text, raw input, spill range, style, merge, comment and hyperlink.",
   :input-schema-source
   "obj(json!({\"cell\": string(\"Cell, e.g. \\\"B7\\\" or \\\"Sheet2!C3\\\"\")}), &[\"cell\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "evaluate_formula",
   :title "Evaluate formula",
   :description
   "\"Evaluate a formula against the active sheet WITHOUT changing any cell, e.g. \\\"=SUM(B2:B10)/COUNT(B2:B10)\\\" or \\\n             \\\"=VLOOKUP(\\\\\\\"x\\\\\\\",A:B,2,FALSE)\\\". `cell` sets the formula's position for relative references and ROW()/COLUMN(). \\\n             Use English function names and `,` between arguments; a formula that couldn't be entered in a cell is an error saying why.\"",
   :input-schema-source
   "obj(\n                json!({\"formula\": string(\"Formula text, with or without the leading =\"), \"cell\": string(\"Evaluate as if in this cell (default: active cell)\")}),\n                &[\"formula\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "select",
   :title "Select",
   :description
   "\"Set the selection (what commands without a `range` param act on). Multiple areas with commas: \\\"A1:B2,D4\\\". \\\n             A \\\"Sheet2!A1\\\" prefix switches sheets.\"",
   :input-schema-source
   "obj(\n                json!({\"range\": string(RANGE), \"active\": string(\"Active cell inside the selection (default: top-left of the last area)\")}),\n                &[\"range\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "format_range",
   :title "Format range",
   :description
   "\"Apply several formats to a range in one call: bold, italic, underline, font name/size, font color, fill color, number \\\n             format, horizontal alignment, wrap, borders. Colors are \\\"#RRGGBB\\\" (fontColor also \\\"auto\\\", fillColor also \\\"none\\\"). \\\n             numberFormat is a name (General, Number, Currency, Accounting, Comma, Percentage, Short Date, Long Date, Time, Fraction, \\\n             Scientific, Text) or a format code (\\\"#,##0.00\\\", \\\"0%\\\", \\\"yyyy-mm-dd\\\"). Each property runs one command; the result \\\n             lists them.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"range\": string(RANGE),\n                    \"bold\": boolean(\"Bold on/off\"),\n                    \"italic\": boolean(\"Italic on/off\"),\n                    \"underline\": boolean(\"Single underline on/off\"),\n                    \"fontName\": string(\"Font family, e.g. \\\"Calibri\\\"\"),\n                    \"fontSize\": {\"type\": \"number\", \"minimum\": 1, \"maximum\": 409, \"description\": \"Font size in points\"},\n                    \"fontColor\": color(\"Text color \\\"#RRGGBB\\\" or \\\"auto\\\"\"),\n                    \"fillColor\": color(\"Background color \\\"#RRGGBB\\\" or \\\"none\\\"\"),\n                    \"numberFormat\": string(\"Number format name or code\"),\n                    \"horizontalAlign\": enumeration(\"Horizontal alignment\", &[\"left\", \"center\", \"right\", \"justify\"]),\n                    \"wrapText\": boolean(\"Wrap text on/off\"),\n                    \"borders\": {\n                        \"description\": \"A border preset name, or {preset, style?, color?}\",\n                        \"oneOf\": [\n                            enumeration(\"Border preset\", BORDER_PRESETS),\n                            obj(json!({\n                                \"preset\": enumeration(\"Border preset\", BORDER_PRESETS),\n                                \"style\": string(\"thin|medium|thick|dashed|dotted|double|hair…\"),\n                                \"color\": color(\"Border color \\\"#RRGGBB\\\"\"),\n                            }), &[\"preset\"]),\n                        ],\n                    },\n                }),\n                &[\"range\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "insert_chart",
   :title "Insert chart",
   :description
   "Insert a chart from a data range (first row/column used as series names and categories, like Excel). Returns the chart id.",
   :input-schema-source
   "obj(\n                json!({\n                    \"range\": string(\"Source data range including headers, e.g. \\\"A1:C6\\\"\"),\n                    \"type\": enumeration(\"Chart type\", CHART_TYPES),\n                    \"subtype\": enumeration(\"Variant (optional)\", &[\"clustered\", \"stacked\", \"stacked100\", \"markers\"]),\n                    \"title\": string(\"Chart title\"),\n                    \"at\": string(\"Top-left anchor cell (default: right of the data)\"),\n                }),\n                &[\"range\", \"type\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "create_table",
   :title "Create table",
   :description
   "Format a range as an Excel table (structured references, banded rows, filter buttons). The first row is the header by default.",
   :input-schema-source
   "obj(\n                json!({\n                    \"range\": string(\"Range including the header row, e.g. \\\"A1:D20\\\"\"),\n                    \"style\": string(\"Table style, e.g. \\\"TableStyleMedium2\\\" (default), \\\"TableStyleLight9\\\"\"),\n                    \"header\": boolean(\"First row holds headers (default true)\"),\n                    \"name\": string(\"Table name (default Table1, Table2…)\"),\n                }),\n                &[\"range\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "sort_range",
   :title "Sort range",
   :description
   "\"Sort a range by one or more columns. keys: [{\\\"column\\\":\\\"B\\\",\\\"order\\\":\\\"desc\\\"}, …] or just [\\\"B\\\"]. Without `range` the \\\n             current region around the selection is sorted; header detection follows Excel unless `header` is given.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"range\": string(RANGE),\n                    \"keys\": {\n                        \"type\": \"array\",\n                        \"minItems\": 1,\n                        \"description\": \"Sort levels, most significant first\",\n                        \"items\": {\"oneOf\": [\n                            string(\"Column letter, e.g. \\\"B\\\" (ascending)\"),\n                            obj(json!({\"column\": string(\"Column letter, e.g. \\\"B\\\"\"), \"order\": enumeration(\"Sort order\", &[\"asc\", \"desc\"])}), &[\"column\"]),\n                        ]},\n                    },\n                    \"header\": boolean(\"The first row is a header (kept in place)\"),\n                }),\n                &[\"keys\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "filter",
   :title "Filter",
   :description
   "\"Filter rows by a column (turns on AutoFilter on the current region, or `range`, when needed). Give `values` (keep rows whose \\\n             cell text is one of them), `custom` ({op:\\\">\\\", value:\\\"10\\\", op2?, value2?, and?}), `top` ({count, bottom?, percent?}), or \\\n             clear:true to remove this column's filter.\"",
   :input-schema-source
   "obj(\n                json!({\n                    \"column\": string(\"Column letter, e.g. \\\"C\\\"\"),\n                    \"range\": string(\"Data range to filter (default: the current region of the selection)\"),\n                    \"values\": {\"type\": \"array\", \"items\": {\"type\": [\"string\", \"number\", \"boolean\"]}, \"description\": \"Values to keep\"},\n                    \"custom\": {\"type\": \"object\", \"description\": \"Custom criteria: {op: \\\"=\\\"|\\\"<>\\\"|\\\">\\\"|\\\">=\\\"|\\\"<\\\"|\\\"<=\\\"|\\\"beginsWith\\\"|\\\"contains\\\"…, value, op2?, value2?, and?: bool}\"},\n                    \"top\": {\"type\": \"object\", \"description\": \"Top/bottom N: {count, bottom?: bool, percent?: bool}\"},\n                    \"blanks\": boolean(\"Also keep blank cells\"),\n                    \"clear\": boolean(\"Clear this column's filter\"),\n                }),\n                &[\"column\"],\n            )",
   :source "crates/mcp/src/tools.rs"}
  {:name "open_workbook",
   :title "Open workbook",
   :description
   "Open a workbook file (.xlsx, .xlsm, .xls, .xlsb, .ods, .csv, .tsv, .txt, .json) and make it active. Excel 97-2003 .xls imports values, formulas and number formats; XLSB and ODS import worksheet data and cached formula values only; check the returned warnings.",
   :input-schema-source
   "obj(json!({\"path\": string(\"File path\")}), &[\"path\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "save_workbook",
   :title "Save workbook",
   :description
   "\"Save the active workbook. The format follows the extension (.xlsx default; .csv/.tsv save the active sheet; .json; .html). \\\n             Without `path` saves to the workbook's current file.\"",
   :input-schema-source
   "obj(json!({\"path\": string(\"Destination path\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "new_workbook",
   :title "New workbook",
   :description
   "Create a new workbook and make it active: blank, or a built-in sample (\"budget\", \"sales\", \"grades\").",
   :input-schema-source
   "obj(json!({\"sample\": enumeration(\"Sample workbook\", &[\"budget\", \"sales\", \"grades\"])}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "undo",
   :title "Undo",
   :description "Undo the last change(s) to the active workbook.",
   :input-schema-source
   "obj(json!({\"steps\": int(\"Number of steps (default 1)\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "redo",
   :title "Redo",
   :description "Redo the last undone change(s).",
   :input-schema-source
   "obj(json!({\"steps\": int(\"Number of steps (default 1)\")}), &[])",
   :source "crates/mcp/src/tools.rs"}
  {:name "screenshot",
   :title "Screenshot",
   :description
   "Save a PNG screenshot of the GridCraft window to `path`. Desktop app only (`gridcraft-cli mcp --connect 7979`).",
   :input-schema-source
   "obj(json!({\"path\": string(\"Output PNG path\")}), &[\"path\"])",
   :source "crates/mcp/src/tools.rs"}
  {:name "list_functions",
   :title "List functions",
   :description
   "List worksheet functions: name, category, signature and description. Filter with `search` (name or description) or `category`.",
   :input-schema-source
   "obj(\n                json!({\"search\": string(\"Substring of the name or description\"), \"category\": string(\"Category, e.g. \\\"Math & Trig\\\", \\\"Lookup & Reference\\\"\")}),\n                &[],\n            )",
   :source "crates/mcp/src/tools.rs"}],
